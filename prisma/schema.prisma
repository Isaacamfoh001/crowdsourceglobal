// CrownSourceGlobal — schema.
//
// M0 scope: Identity (Better Auth-owned tables) + CustomerProfile.
// M1 scope: Catalogue (Category, Vendor, VendorListing) + Pricing
// (BulkPriceTier, VendorCostRule) — read-only public marketplace browsing.
// M2 scope: Cart, Order, Fulfilment, Payment — the standard/multi-vendor
// customer commerce loop (Workflows A/B), with a mocked payment provider.
// No Quotation/CustomSourcing/Refund/PayoutRun tables yet — those belong
// to later milestones per the approved roadmap (docs/architecture/overview.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Better Auth-owned. Field shape matches better-auth's core user schema
/// (see docs/decisions/0002-authentication.md) — do not add CrownSourceGlobal
/// business fields (role, ownership, etc.) here; those live on CustomerProfile.
model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  customerProfile CustomerProfile?

  vendorApplication VendorApplication?
  vendorMemberships VendorMembership[]
  adminUser         AdminUser?
  sentMessages      Message[]

  @@unique([email])
  @@map("user")
}

/// Better Auth-owned.
model Session {
  id        String   @id
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

/// Better Auth-owned. One row per linked credential/OAuth provider for a
/// user — e.g. a Google-linked user and an email/password credential are
/// two Account rows pointing at the same User (see ADR 0002).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Better Auth-owned. Email verification and password reset tokens.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// CrownSourceGlobal-owned. The buyer-side profile — created automatically
/// after every successful registration (email/password or Google), via a
/// Better Auth `databaseHooks.user.create.after` hook, so a user reaches the
/// same CustomerProfile regardless of authentication method (PROJECT.md §54.6).
///
/// Deliberately minimal for M0: no organizationId/businessInfo yet — see
/// docs/domain/entities.md for the full future shape, added when the
/// business/organization flows actually need it.
model CustomerProfile {
  id          String   @id @default(cuid())
  displayName String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  carts         Cart[]
  orders        Order[]
  conversations Conversation[]

  @@map("customer_profile")
}

// ---------------------------------------------------------------------------
// M1 — Catalogue & Pricing
//
// VendorListing is the sellable unit (ADR 0003) — there is no canonical
// cross-vendor Product. Public reads always filter on approvalStatus=APPROVED
// and listingStatus=ACTIVE; the two are tracked as separate axes (admin
// review outcome vs. vendor-facing visibility) rather than one combined
// status, mirroring how Order.status/paymentStatus stay separate.
// ---------------------------------------------------------------------------

enum VendorVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ListingApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum MarginRuleType {
  PERCENTAGE
  FIXED
}

/// Category taxonomy. Self-referencing for subcategories (e.g. "Hair &
/// Beauty Supplies" -> "Hair Extensions & Wigs"). Two levels are seeded for
/// M1; the model itself supports arbitrary depth.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentCategoryId String?
  parent           Category?  @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryToSubcategory")

  listings VendorListing[]

  @@index([parentCategoryId])
  @@map("category")
}

/// Supplier company profile. Vendor-owned listings are the sellable unit —
/// see VendorListing. Created only once a VendorApplication is approved
/// (see VendorApplication below) — there is no Vendor row for an applicant
/// still under review.
///
/// `contactEmail`/`contactPhone` are CrownSource-operational contact details
/// (private) — never select these in a public storefront/listing DTO. Public
/// store identity is `companyName`/`description`/`logoUrl`/location/
/// `sellerType`/`categorySlugs` only (see modules/vendors — the "no contact
/// bypass" rule in CLAUDE.md).
model Vendor {
  id                 String                   @id @default(cuid())
  companyName        String
  description        String?
  verificationStatus VendorVerificationStatus @default(PENDING)
  storefrontSlug     String                   @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  sellerType    SellerType?
  logoUrl       String?
  country       String?
  region        String?
  city          String?
  categorySlugs String[]    @default([])

  /// Private — CrownSource↔vendor operational contact only.
  contactEmail        String?
  contactPhone        String?
  leadTimeDaysDefault Int?

  /// Private pickup/collection details — never on the public storefront.
  /// Deliberately separate from the general country/region/city above:
  /// those describe where the store operates commercially, this is the
  /// precise dock CrownSource-arranged collection actually happens at.
  pickupAddressLine1 String?
  pickupContactName  String?
  pickupContactPhone String?
  pickupHours        String?
  pickupNotes        String?

  listings    VendorListing[]
  fulfilments Fulfilment[]
  orderItems  OrderItem[]

  memberships VendorMembership[]
  application VendorApplication?

  participantConversations Conversation[] @relation("VendorParticipantConversations")
  contextConversations     Conversation[] @relation("ConversationContextVendor")

  @@map("vendor")
}

/// The sellable unit (ADR 0003). No canonical cross-vendor Product — two
/// vendors selling a similar item are two independent listings, related
/// only by shared Category.
model VendorListing {
  id          String  @id @default(cuid())
  title       String
  description String
  images      Json    @default("[]")
  specs       Json?
  basePrice   Decimal @db.Decimal(12, 2)
  currency    String  @default("GHS")

  moq                Int                @default(1)
  maxOq              Int?
  leadTimeDays       Int?
  availableQuantity  Int                @default(0)
  availabilityStatus AvailabilityStatus @default(IN_STOCK)

  approvalStatus ListingApprovalStatus @default(PENDING)
  listingStatus  ListingStatus         @default(DRAFT)

  /// First-time submission is tracked via this timestamp (not a new enum
  /// value) — a listing is a true, never-submitted draft when this is null,
  /// matching entities.md's existing two-axis model (approvalStatus x
  /// listingStatus) rather than adding a redundant "PENDING_REVIEW" status.
  submittedAt DateTime?

  /// A material edit to an already APPROVED+ACTIVE listing is staged here
  /// rather than applied in place, so the live public row is undisturbed
  /// while the edit is under re-review (approvalStatus flips to PENDING but
  /// listingStatus stays ACTIVE). Admin approval merges this onto the real
  /// fields and clears it; reject/changes-requested discards or retains it
  /// for further vendor edits. See modules/vendors listing service — this is
  /// deliberately not a full version-history table (out of scope for M3).
  pendingChanges Json?

  /// Admin's reason when approvalStatus = CHANGES_REQUESTED, shown to the
  /// vendor in their portal. Cleared on the next admin decision.
  changesRequestedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bulkPriceTiers BulkPriceTier[]
  vendorCostRule VendorCostRule?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reservations   InventoryReservation[]
  conversations  Conversation[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([approvalStatus, listingStatus])
  @@map("vendor_listing")
}

/// Pricing-owned. Quantity-based pricing tiers for a listing — customer-
/// facing, safe to display publicly.
model BulkPriceTier {
  id          String  @id @default(cuid())
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal @db.Decimal(12, 2)

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, minQuantity])
  @@index([listingId])
  @@map("bulk_price_tier")
}

/// Pricing-owned. Vendor supply cost and margin policy — commercially
/// sensitive. No public read path may ever select these fields (see
/// modules/pricing — there is deliberately no public accessor for this
/// model, only BulkPriceTier is exposed to catalogue reads).
model VendorCostRule {
  id               String         @id @default(cuid())
  vendorSupplyCost Decimal        @db.Decimal(12, 2)
  marginRuleType   MarginRuleType
  marginValue      Decimal        @db.Decimal(8, 4)

  listingId String        @unique
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("vendor_cost_rule")
}

// ---------------------------------------------------------------------------
// M2 — Cart, Order, Fulfilment, Payment
//
// Sequencing follows ADR 0004 (Model B): checkout creates a PENDING_PAYMENT
// Order with OrderItems as the first authoritative commercial snapshot
// (see docs/workflows/workflows.md); Fulfilments/FulfilmentItems are only
// created once payment confirms and always copy from OrderItem, never
// re-price. Order.status and Order.paymentStatus stay separate axes
// (docs/domain/state-machines.md). No Quotation table yet — bulk pricing is
// applied directly within cart/checkout for the standard purchase paths
// (Workflows A/B), not via a separate instant-quotation object.
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  CONVERTED
}

/// Mutable, pre-commercial buyer intent. Cart is CustomerProfile-owned —
/// there is no anonymous/guest cart in the approved model, which is why
/// Add to Cart requires authentication (see the redirect-preservation work
/// in modules/identity/policy.ts).
model Cart {
  id        String     @id @default(cuid())
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@index([customerProfileId, status])
  @@map("cart")
}

/// No price stored — always resolved live against current Pricing when the
/// cart is displayed or checked out (see modules/pricing.resolveUnitPrice).
model CartItem {
  id        String   @id @default(cuid())
  quantity  Int
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
  @@index([cartId])
  @@map("cart_item")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

/// What CrownSourceGlobal sold the customer. `status` (fulfilment track)
/// and `paymentStatus` are tracked separately per the approved state
/// machine — a COMPLETED order can still carry a REFUNDED paymentStatus.
model Order {
  id            String             @id @default(cuid())
  orderNumber   String             @unique
  status        OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus OrderPaymentStatus @default(UNPAID)

  currency String  @default("GHS")
  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  deliveryInfo Json

  /// Set once Fulfilments have been created for this order's confirmation —
  /// the idempotency marker called for in docs/domain/state-machines.md
  /// ("Fulfilment creation is idempotent per Order-confirmation event").
  fulfilmentsCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  items         OrderItem[]
  fulfilments   Fulfilment[]
  payments      Payment[]
  reservations  InventoryReservation[]
  conversations Conversation[]

  @@index([customerProfileId])
  @@map("order")
}

/// The first point standard-path pricing becomes authoritative (see
/// docs/workflows/workflows.md). `description`/`unitPrice` are snapshotted
/// values, independent of the live VendorListing from this point on.
model OrderItem {
  id                 String  @id @default(cuid())
  description        String
  quantity           Int
  unitPrice          Decimal @db.Decimal(12, 2)
  /// What CrownSourceGlobal owes the vendor for this line (vendor supply
  /// cost x quantity, snapshotted from VendorCostRule at order-creation
  /// time) — never derived from live VendorCostRule again after this.
  vendorPayableBasis Decimal @db.Decimal(12, 2)
  lineTotal          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  listingId String?
  listing   VendorListing? @relation(fields: [listingId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  fulfilmentItems FulfilmentItem[]

  @@index([orderId])
  @@map("order_item")
}

enum FulfilmentStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  COMPLETED
  EXCEPTION
  CANCELLED
}

/// Which physical route a Fulfilment takes to reach the customer — decided
/// once, at Fulfilment-creation time, from the vendor's country at that
/// moment (never re-derived later, same snapshot philosophy as
/// OrderItem/FulfilmentItem pricing). Domestic vendors hand off to a
/// CrownSource-arranged local collection; international vendors ship to a
/// CrownSource-designated Ghana ReceivingLocation first. Keeping this as an
/// explicit field — rather than checking vendor.country throughout the UI —
/// is what lets M4 UI/services branch on origin without hard-coding country
/// logic in multiple places (see docs/domain/entities.md M4 addendum).
enum FulfilmentOrigin {
  DOMESTIC_COLLECTION
  INTERNATIONAL_INBOUND
}

/// Vendor-scoped responsibility for a subset of an Order. No uniqueness
/// constraint on (orderId, vendorId) — multiple Fulfilments per vendor per
/// Order are legal (future partial/split fulfilment), per entities.md.
model Fulfilment {
  id        String           @id @default(cuid())
  status    FulfilmentStatus @default(PENDING)
  origin    FulfilmentOrigin
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  items     FulfilmentItem[]
  issues    FulfilmentIssue[]
  shipments Shipment[]

  @@index([orderId])
  @@index([vendorId])
  @@index([vendorId, status])
  /// Backs the admin Operations queue — filtered by status without a vendor.
  @@index([status])
  @@map("fulfilment")
}

enum FulfilmentIssueStatus {
  OPEN
  RESOLVED
}

/// The M4 "operational exception boundary" — a vendor-reportable problem
/// that pauses a Fulfilment (status flips to EXCEPTION) for CrownSource
/// operations to resolve. Deliberately does not touch OrderItem, payment
/// amounts, or quantities — a real refund/replacement/quantity-adjustment
/// platform is out of scope for M4 (see CLAUDE.md's overengineering rule).
model FulfilmentIssue {
  id          String                @id @default(cuid())
  status      FulfilmentIssueStatus @default(OPEN)
  category    String
  description String

  reportedByUserId String
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNotes  String?

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId])
  @@index([status])
  @@map("fulfilment_issue")
}

enum PayoutEligibility {
  NOT_ELIGIBLE
  ELIGIBLE
  ON_HOLD
  CLAIMED
}

/// Never independently authoritative — always copies its economics from
/// the parent OrderItem at Fulfilment-creation time, no new pricing
/// evaluation (docs/workflows/workflows.md).
model FulfilmentItem {
  id                 String            @id @default(cuid())
  quantity           Int
  unitPrice          Decimal           @db.Decimal(12, 2)
  vendorPayableBasis Decimal           @db.Decimal(12, 2)
  payoutEligibility  PayoutEligibility @default(NOT_ELIGIBLE)
  payoutHold         Boolean           @default(false)
  payoutHoldReason   String?
  createdAt          DateTime          @default(now())

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([fulfilmentId])
  @@index([orderItemId])
  @@map("fulfilment_item")
}

/// A CrownSource-controlled physical receiving point for international
/// inbound Fulfilments — an office, warehouse, consolidation facility, or
/// 3PL partner. Never assume there is exactly one; operations assigns the
/// appropriate one per Shipment. Private/admin-only — never on any public
/// DTO (this is operational infrastructure, not a storefront address).
model ReceivingLocation {
  id     String  @id @default(cuid())
  name   String
  type   String? // free text: "office" | "warehouse" | "consolidation" | "freight_forwarder" | ...
  active Boolean @default(true)

  country      String
  region       String?
  city         String?
  addressLine1 String

  contactName  String?
  contactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@index([active])
  @@map("receiving_location")
}

enum ShipmentStatus {
  CREATED
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  EXCEPTION
}

/// Physical movement of goods — distinct from Fulfilment (vendor
/// responsibility) and Order (commercial purchase), per entities.md's
/// existing separation. `fulfilmentId` is intentionally NOT unique: the V1
/// path is exactly one Shipment per Fulfilment, but leaving this
/// unconstrained means a future partial-shipment split (one Fulfilment,
/// several Shipments) needs no schema change. True consolidation (several
/// Fulfilments sharing one Shipment) would still need a join table later —
/// documented as a future path, not built now.
///
/// CrownSource/logistics-controlled fields only — nothing here is ever
/// vendor- or customer-writable directly; see modules/fulfilment/policy.ts.
model Shipment {
  id     String         @id @default(cuid())
  status ShipmentStatus @default(CREATED)

  carrier           String?
  trackingReference String?

  /// Domestic collection — set by CrownSource operations once the vendor
  /// marks READY.
  collectionScheduledAt DateTime?
  collectionNotes       String?
  collectedAt           DateTime?
  collectedByUserId     String?

  /// International inbound — shippedAt/expectedArrivalAt are vendor-
  /// entered; receivedAt/receivedByUserId are CrownSource-confirmed only.
  receivingLocationId String?
  receivingLocation   ReceivingLocation? @relation(fields: [receivingLocationId], references: [id])
  shippedAt           DateTime?
  expectedArrivalAt   DateTime?
  receivedAt          DateTime?
  receivedByUserId    String?

  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  deliveryFailedAt DateTime?
  deliveryNotes    String?

  /// An additional signal only — never the sole authoritative delivery
  /// confirmation (CLAUDE.md / M4 brief: a customer action must never
  /// itself set `status = DELIVERED`).
  customerConfirmedReceiptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId])
  @@index([status])
  @@index([trackingReference])
  @@map("shipment")
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
}

/// `provider`/`method` are plain strings, not enums — M2 only ever writes
/// "mock", and predefining real-provider enum values (Paystack method
/// names, etc.) before that integration exists would be guessing ahead of
/// the actual API. `status` is the real state machine and stays an enum.
model Payment {
  id              String        @id @default(cuid())
  provider        String        @default("mock")
  method          String        @default("mock")
  status          PaymentStatus @default(INITIATED)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("GHS")
  providerEventId String?       @unique
  initiatedAt     DateTime      @default(now())
  confirmedAt     DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment")
}

enum ReservationStatus {
  HELD
  RELEASED
  COMMITTED
}

/// Reservation is an atomic conditional decrement of
/// VendorListing.availableQuantity, created in the same transaction as the
/// PENDING_PAYMENT Order (docs/workflows/workflows.md Workflow G).
model InventoryReservation {
  id        String            @id @default(cuid())
  quantity  Int
  status    ReservationStatus @default(HELD)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([orderId])
  @@map("inventory_reservation")
}

enum IdempotencyScope {
  CHECKOUT
  PAYMENT
}

/// Backs the "double-click Pay" / duplicate-submission protection required
/// by CLAUDE.md's commerce-integrity rules. `resultRef` points at the
/// entity the first successful attempt produced (a Payment id for the
/// PAYMENT scope).
model IdempotencyKey {
  id        String           @id @default(cuid())
  key       String           @unique
  scope     IdempotencyScope
  resultRef String
  createdAt DateTime         @default(now())

  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------
// M3 — Vendor onboarding, VendorMembership, admin, messaging
//
// A VendorApplication is the private onboarding/moderation record; Vendor
// itself (above) is only created once an application is APPROVED, keeping
// the lean, partially-public Vendor row separate from private application
// data (CLAUDE.md's "public vs private vendor information" boundary).
// Conversation/Message implement the two structurally-separate managed
// messaging shapes (Customer<->CSG, Vendor<->CSG) — there is deliberately no
// participant shape that lets a buyer and a vendor share a thread.
// ---------------------------------------------------------------------------

enum SellerType {
  INDIVIDUAL
  SOLE_TRADER
  REGISTERED_BUSINESS
  DISTRIBUTOR_WHOLESALER
  MANUFACTURER
  ORGANIZATION
  OTHER
}

enum VendorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

/// One application per User, ever (see modules/vendor-applications) — reused
/// across resubmission after CHANGES_REQUESTED/REJECTED rather than creating
/// a new row, so "leave and resume" and "edit after rejection" are the same
/// mechanism. Approval creates the Vendor row and an OWNER VendorMembership
/// in one transaction.
model VendorApplication {
  id     String                  @id @default(cuid())
  status VendorApplicationStatus @default(DRAFT)

  sellerType SellerType?

  contactName  String?
  contactEmail String?
  contactPhone String?

  displayName        String?
  legalName          String?
  storeDescription   String?
  registrationNumber String?
  taxIdentifier      String?
  yearEstablished    Int?
  websiteUrl         String?

  country      String?
  region       String?
  city         String?
  addressLine1 String?

  categorySlugs       String[] @default([])
  sellingMode         String?
  bulkCapable         Boolean  @default(false)
  leadTimeDaysDefault Int?
  serviceAreas        String?

  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewerUserId String?
  /// Shown to the applicant when status = CHANGES_REQUESTED or REJECTED.
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicantUserId String @unique
  applicant       User   @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)

  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  @@index([status])
  @@map("vendor_application")
}

enum VendorMembershipRole {
  OWNER
  STAFF
}

/// Only a valid VendorMembership grants Vendor Portal access to that Vendor
/// — never derived from anything else. M3 does not differentiate OWNER vs
/// STAFF capabilities yet (all members can manage listings); the role field
/// exists so that differentiation can be added later without a schema
/// change (CLAUDE.md's "capable of supporting multiple users per Vendor").
model VendorMembership {
  id        String               @id @default(cuid())
  role      VendorMembershipRole @default(OWNER)
  createdAt DateTime             @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([vendorId])
  @@map("vendor_membership")
}

enum AdminRole {
  SUPER_ADMIN
  OPS_ADMIN
  FINANCE_ADMIN
}

/// Grants CrownSourceGlobal staff access — created only via the dev-only
/// `npm run admin:grant` CLI script (see scripts/grant-admin.ts), never via
/// a public route or a hardcoded email. Only SUPER_ADMIN/OPS_ADMIN have any
/// capability wired up in M3 (vendor/listing moderation, managed messaging);
/// FINANCE_ADMIN is modeled per the approved 3-role split but unused until
/// payments/payouts admin work exists.
model AdminUser {
  id        String    @id @default(cuid())
  role      AdminRole
  createdAt DateTime  @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_user")
}

enum ConversationParticipantType {
  CUSTOMER
  VENDOR
}

enum ConversationContextType {
  LISTING
  VENDOR
  ORDER
  GENERAL
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/// The non-CrownSource party is either `customerProfileId` (participantType
/// CUSTOMER) or `vendorId` (participantType VENDOR) — never both, and there
/// is no field that could make a vendor a participant in a customer thread.
/// `contextVendorId`/`contextListingId`/`contextOrderId` describe what a
/// CUSTOMER conversation is *about* (e.g. "asking about this listing") —
/// this is metadata for CrownSource staff, not a grant of vendor visibility.
model Conversation {
  id              String                      @id @default(cuid())
  participantType ConversationParticipantType
  contextType     ConversationContextType     @default(GENERAL)
  status          ConversationStatus          @default(OPEN)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation("VendorParticipantConversations", fields: [vendorId], references: [id], onDelete: Cascade)

  contextListingId String?
  contextListing   VendorListing? @relation(fields: [contextListingId], references: [id])

  contextVendorId String?
  contextVendor   Vendor? @relation("ConversationContextVendor", fields: [contextVendorId], references: [id])

  contextOrderId String?
  contextOrder   Order?  @relation(fields: [contextOrderId], references: [id])

  messages Message[]

  @@index([customerProfileId])
  @@index([vendorId])
  /// Backs the staff inbox — filtered by status, ordered by recency.
  @@index([status, updatedAt])
  @@map("conversation")
}

model Message {
  id            String   @id @default(cuid())
  body          String
  /// Snapshotted at send time — true when the sender was CrownSource staff
  /// replying (customer/vendor side is always false), independent of the
  /// AdminUser table so a later staff-role change never rewrites history.
  senderIsStaff Boolean  @default(false)
  createdAt     DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUserId String
  senderUser   User   @relation(fields: [senderUserId], references: [id])

  /// Covers "messages for this conversation, chronological" without a
  /// separate sort step — the shape of every message-history query.
  @@index([conversationId, createdAt])
  @@map("message")
}

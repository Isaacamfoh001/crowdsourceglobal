// CrownSourceGlobal — schema.
//
// M0 scope: Identity (Better Auth-owned tables) + CustomerProfile.
// M1 scope: Catalogue (Category, Vendor, VendorListing) + Pricing
// (BulkPriceTier, VendorCostRule) — read-only public marketplace browsing.
// Do not add cart/order/payment/quotation/etc. models here — those belong
// to later milestones per the approved roadmap (docs/architecture/overview.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Better Auth-owned. Field shape matches better-auth's core user schema
/// (see docs/decisions/0002-authentication.md) — do not add CrownSourceGlobal
/// business fields (role, ownership, etc.) here; those live on CustomerProfile.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  customerProfile CustomerProfile?

  @@unique([email])
  @@map("user")
}

/// Better Auth-owned.
model Session {
  id        String   @id
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

/// Better Auth-owned. One row per linked credential/OAuth provider for a
/// user — e.g. a Google-linked user and an email/password credential are
/// two Account rows pointing at the same User (see ADR 0002).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Better Auth-owned. Email verification and password reset tokens.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// CrownSourceGlobal-owned. The buyer-side profile — created automatically
/// after every successful registration (email/password or Google), via a
/// Better Auth `databaseHooks.user.create.after` hook, so a user reaches the
/// same CustomerProfile regardless of authentication method (PROJECT.md §54.6).
///
/// Deliberately minimal for M0: no organizationId/businessInfo yet — see
/// docs/domain/entities.md for the full future shape, added when the
/// business/organization flows actually need it.
model CustomerProfile {
  id          String   @id @default(cuid())
  displayName String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profile")
}

// ---------------------------------------------------------------------------
// M1 — Catalogue & Pricing
//
// VendorListing is the sellable unit (ADR 0003) — there is no canonical
// cross-vendor Product. Public reads always filter on approvalStatus=APPROVED
// and listingStatus=ACTIVE; the two are tracked as separate axes (admin
// review outcome vs. vendor-facing visibility) rather than one combined
// status, mirroring how Order.status/paymentStatus stay separate.
// ---------------------------------------------------------------------------

enum VendorVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ListingApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum MarginRuleType {
  PERCENTAGE
  FIXED
}

/// Category taxonomy. Self-referencing for subcategories (e.g. "Hair &
/// Beauty Supplies" -> "Hair Extensions & Wigs"). Two levels are seeded for
/// M1; the model itself supports arbitrary depth.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentCategoryId String?
  parent           Category?  @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryToSubcategory")

  listings VendorListing[]

  @@index([parentCategoryId])
  @@map("category")
}

/// Supplier company profile. Vendor-owned listings are the sellable unit —
/// see VendorListing.
model Vendor {
  id                 String                    @id @default(cuid())
  companyName        String
  description        String?
  verificationStatus VendorVerificationStatus  @default(PENDING)
  storefrontSlug     String                    @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  listings VendorListing[]

  @@map("vendor")
}

/// The sellable unit (ADR 0003). No canonical cross-vendor Product — two
/// vendors selling a similar item are two independent listings, related
/// only by shared Category.
model VendorListing {
  id          String   @id @default(cuid())
  title       String
  description String
  images      Json     @default("[]")
  specs       Json?
  basePrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("GHS")

  moq                Int                 @default(1)
  maxOq              Int?
  leadTimeDays       Int?
  availableQuantity  Int                 @default(0)
  availabilityStatus AvailabilityStatus  @default(IN_STOCK)

  approvalStatus ListingApprovalStatus @default(PENDING)
  listingStatus  ListingStatus         @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bulkPriceTiers BulkPriceTier[]
  vendorCostRule VendorCostRule?

  @@index([vendorId])
  @@index([categoryId])
  @@index([approvalStatus, listingStatus])
  @@map("vendor_listing")
}

/// Pricing-owned. Quantity-based pricing tiers for a listing — customer-
/// facing, safe to display publicly.
model BulkPriceTier {
  id          String  @id @default(cuid())
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal @db.Decimal(12, 2)

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, minQuantity])
  @@index([listingId])
  @@map("bulk_price_tier")
}

/// Pricing-owned. Vendor supply cost and margin policy — commercially
/// sensitive. No public read path may ever select these fields (see
/// modules/pricing — there is deliberately no public accessor for this
/// model, only BulkPriceTier is exposed to catalogue reads).
model VendorCostRule {
  id                String         @id @default(cuid())
  vendorSupplyCost  Decimal        @db.Decimal(12, 2)
  marginRuleType    MarginRuleType
  marginValue       Decimal        @db.Decimal(8, 4)

  listingId String        @unique
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("vendor_cost_rule")
}

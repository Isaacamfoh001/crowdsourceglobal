// CrownSourceGlobal — schema.
//
// M0 scope: Identity (Better Auth-owned tables) + CustomerProfile.
// M1 scope: Catalogue (Category, Vendor, VendorListing) + Pricing
// (BulkPriceTier, VendorCostRule) — read-only public marketplace browsing.
// M2 scope: Cart, Order, Fulfilment, Payment — the standard/multi-vendor
// customer commerce loop (Workflows A/B), with a mocked payment provider.
// No Quotation/CustomSourcing/Refund/PayoutRun tables yet — those belong
// to later milestones per the approved roadmap (docs/architecture/overview.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Better Auth-owned. Field shape matches better-auth's core user schema
/// (see docs/decisions/0002-authentication.md) — do not add CrownSourceGlobal
/// business fields (role, ownership, etc.) here; those live on CustomerProfile.
model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  customerProfile CustomerProfile?

  vendorApplication VendorApplication?
  vendorMemberships VendorMembership[]
  adminUser         AdminUser?
  sentMessages      Message[]

  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@unique([email])
  @@map("user")
}

/// Better Auth-owned.
model Session {
  id        String   @id
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

/// Better Auth-owned. One row per linked credential/OAuth provider for a
/// user — e.g. a Google-linked user and an email/password credential are
/// two Account rows pointing at the same User (see ADR 0002).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Better Auth-owned. Email verification and password reset tokens.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// Better Auth-owned (M13). Backs its built-in database-backed rate
/// limiter (rateLimit: { storage: "database", ... }, lib/auth.ts) —
/// persists across restarts and multiple instances, unlike the in-memory
/// default (a single Render web-service restart/redeploy would otherwise
/// silently reset every limit to zero). Better Auth generates its own id
/// and manages every row itself, same as User/Session/Account above —
/// nothing in CrownSourceGlobal's own code reads or writes this table.
model RateLimit {
  id          String  @id
  key         String?
  count       Int?
  lastRequest BigInt?

  @@unique([key])
  @@map("rate_limit")
}

/// CrownSourceGlobal-owned. The buyer-side profile — created automatically
/// after every successful registration (email/password or Google), via a
/// Better Auth `databaseHooks.user.create.after` hook, so a user reaches the
/// same CustomerProfile regardless of authentication method (PROJECT.md §54.6).
///
/// Deliberately minimal for M0: no organizationId/businessInfo yet — see
/// docs/domain/entities.md for the full future shape, added when the
/// business/organization flows actually need it.
model CustomerProfile {
  id          String   @id @default(cuid())
  displayName String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  carts            Cart[]
  orders           Order[]
  quotations       Quotation[]
  sourcingRequests CustomSourcingRequest[]
  conversations    Conversation[]
  resolutionCases  ResolutionCase[]
  addresses        CustomerAddress[]

  @@map("customer_profile")
}

/// Saved delivery addresses (M10 hardening). Purely a customer-convenience
/// record for pre-filling checkout — mutable, and NEVER read back by an
/// existing Order. `Order.deliveryInfo` (JSON) remains the sole immutable
/// snapshot of what was actually used at checkout time; editing or deleting
/// a CustomerAddress must never change any past Order's displayed address.
model CustomerAddress {
  id            String   @id @default(cuid())
  label         String?
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  region        String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
  @@map("customer_address")
}

// ---------------------------------------------------------------------------
// M1 — Catalogue & Pricing
//
// VendorListing is the sellable unit (ADR 0003) — there is no canonical
// cross-vendor Product. Public reads always filter on approvalStatus=APPROVED
// and listingStatus=ACTIVE; the two are tracked as separate axes (admin
// review outcome vs. vendor-facing visibility) rather than one combined
// status, mirroring how Order.status/paymentStatus stay separate.
// ---------------------------------------------------------------------------

enum VendorVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ListingApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum MarginRuleType {
  PERCENTAGE
  FIXED
}

/// Category taxonomy. Self-referencing for subcategories (e.g. "Hair &
/// Beauty Supplies" -> "Hair Extensions & Wigs"). Two levels are seeded for
/// M1; the model itself supports arbitrary depth.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentCategoryId String?
  parent           Category?  @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryToSubcategory")

  listings         VendorListing[]
  sourcingRequests CustomSourcingRequest[]

  @@index([parentCategoryId])
  @@map("category")
}

/// Supplier company profile. Vendor-owned listings are the sellable unit —
/// see VendorListing. Created only once a VendorApplication is approved
/// (see VendorApplication below) — there is no Vendor row for an applicant
/// still under review.
///
/// `contactEmail`/`contactPhone` are CrownSource-operational contact details
/// (private) — never select these in a public storefront/listing DTO. Public
/// store identity is `companyName`/`description`/`logoUrl`/location/
/// `sellerType`/`categorySlugs` only (see modules/vendors — the "no contact
/// bypass" rule in CLAUDE.md).
model Vendor {
  id                 String                   @id @default(cuid())
  companyName        String
  description        String?
  verificationStatus VendorVerificationStatus @default(PENDING)
  storefrontSlug     String                   @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  sellerType    SellerType?
  logoUrl       String?
  country       String?
  region        String?
  city          String?
  categorySlugs String[]    @default([])

  /// Private — CrownSource↔vendor operational contact only.
  contactEmail        String?
  contactPhone        String?
  leadTimeDaysDefault Int?

  /// Private pickup/collection details — never on the public storefront.
  /// Deliberately separate from the general country/region/city above:
  /// those describe where the store operates commercially, this is the
  /// precise dock CrownSource-arranged collection actually happens at.
  pickupAddressLine1 String?
  pickupContactName  String?
  pickupContactPhone String?
  pickupHours        String?
  pickupNotes        String?

  listings        VendorListing[]
  fulfilments     Fulfilment[]
  orderItems      OrderItem[]
  quotationItems  QuotationItem[]
  /// Internal-only (M6) — CrownSource operations considering this Vendor as
  /// a custom sourcing supply option. Never a public/self-serve bidding
  /// mechanism (see docs/workflows/workflows.md Workflow R).
  sourcingOptions SourcingOption[]

  memberships VendorMembership[]
  application VendorApplication?

  participantConversations Conversation[] @relation("VendorParticipantConversations")
  contextConversations     Conversation[] @relation("ConversationContextVendor")

  /// Vendor Finance (M11) — see docs/decisions/0009-vendor-earnings-and-settlement.md.
  vendorEarnings       VendorEarning[]
  financialAdjustments VendorFinancialAdjustment[]
  settlements          VendorSettlement[]
  payoutDestination    VendorPayoutDestination?

  @@map("vendor")
}

/// The sellable unit (ADR 0003). No canonical cross-vendor Product — two
/// vendors selling a similar item are two independent listings, related
/// only by shared Category.
model VendorListing {
  id          String  @id @default(cuid())
  title       String
  description String
  images      Json    @default("[]")
  specs       Json?
  basePrice   Decimal @db.Decimal(12, 2)
  currency    String  @default("GHS")

  moq                Int                @default(1)
  maxOq              Int?
  leadTimeDays       Int?
  availableQuantity  Int                @default(0)
  availabilityStatus AvailabilityStatus @default(IN_STOCK)

  approvalStatus ListingApprovalStatus @default(PENDING)
  listingStatus  ListingStatus         @default(DRAFT)

  /// First-time submission is tracked via this timestamp (not a new enum
  /// value) — a listing is a true, never-submitted draft when this is null,
  /// matching entities.md's existing two-axis model (approvalStatus x
  /// listingStatus) rather than adding a redundant "PENDING_REVIEW" status.
  submittedAt DateTime?

  /// A material edit to an already APPROVED+ACTIVE listing is staged here
  /// rather than applied in place, so the live public row is undisturbed
  /// while the edit is under re-review (approvalStatus flips to PENDING but
  /// listingStatus stays ACTIVE). Admin approval merges this onto the real
  /// fields and clears it; reject/changes-requested discards or retains it
  /// for further vendor edits. See modules/vendors listing service — this is
  /// deliberately not a full version-history table (out of scope for M3).
  pendingChanges Json?

  /// Admin's reason when approvalStatus = CHANGES_REQUESTED, shown to the
  /// vendor in their portal. Cleared on the next admin decision.
  changesRequestedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bulkPriceTiers  BulkPriceTier[]
  vendorCostRule  VendorCostRule?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  quotationItems  QuotationItem[]
  reservations    InventoryReservation[]
  conversations   Conversation[]
  sourcingOptions SourcingOption[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([approvalStatus, listingStatus])
  /// Backs the M8 admin-dashboard listing-moderation attention/ageing query.
  @@index([approvalStatus, submittedAt])
  @@map("vendor_listing")
}

/// Pricing-owned. Quantity-based pricing tiers for a listing — customer-
/// facing, safe to display publicly.
model BulkPriceTier {
  id          String  @id @default(cuid())
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal @db.Decimal(12, 2)

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, minQuantity])
  @@index([listingId])
  @@map("bulk_price_tier")
}

/// Pricing-owned. Vendor supply cost and margin policy — commercially
/// sensitive. No public read path may ever select these fields (see
/// modules/pricing — there is deliberately no public accessor for this
/// model, only BulkPriceTier is exposed to catalogue reads).
model VendorCostRule {
  id               String         @id @default(cuid())
  vendorSupplyCost Decimal        @db.Decimal(12, 2)
  marginRuleType   MarginRuleType
  marginValue      Decimal        @db.Decimal(8, 4)

  listingId String        @unique
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("vendor_cost_rule")
}

// ---------------------------------------------------------------------------
// M2 — Cart, Order, Fulfilment, Payment
//
// Sequencing follows ADR 0004 (Model B): checkout creates a PENDING_PAYMENT
// Order with OrderItems as the first authoritative commercial snapshot
// (see docs/workflows/workflows.md); Fulfilments/FulfilmentItems are only
// created once payment confirms and always copy from OrderItem, never
// re-price. Order.status and Order.paymentStatus stay separate axes
// (docs/domain/state-machines.md). No Quotation table yet — bulk pricing is
// applied directly within cart/checkout for the standard purchase paths
// (Workflows A/B), not via a separate instant-quotation object.
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  CONVERTED
}

/// Mutable, pre-commercial buyer intent. Cart is CustomerProfile-owned —
/// there is no anonymous/guest cart in the approved model, which is why
/// Add to Cart requires authentication (see the redirect-preservation work
/// in modules/identity/policy.ts).
model Cart {
  id        String     @id @default(cuid())
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@index([customerProfileId, status])
  @@map("cart")
}

/// No price stored — always resolved live against current Pricing when the
/// cart is displayed or checked out (see modules/pricing.resolveUnitPrice).
model CartItem {
  id        String   @id @default(cuid())
  quantity  Int
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
  @@index([cartId])
  @@map("cart_item")
}

// ---------------------------------------------------------------------------
// M5 — Instant Bulk Quotation
//
// An INSTANT Quotation is possible only when commercial terms are fully
// deterministic from existing approved catalogue/pricing data — no manual
// sourcing. Quotation is NOT Cart: it is an issued, immutable commercial
// snapshot with an expiry, not mutable shopping intent (see
// docs/workflows/workflows.md Workflow Q). There is no persisted DRAFT row —
// the pre-issuance "quote builder" state lives in a cookie (see
// lib/actions/quotation.ts) and a Quotation row is only ever written at the
// moment of issuance, already ISSUED.
//
// `origin` gained CUSTOM_SOURCING in M6 — a custom quote's single line is
// staff-prepared from SourcingAllocations, never re-derived from catalogue
// pricing. `status` gained SUPERSEDED in M6, for the reissue/revision
// mechanism (old Quote -> SUPERSEDED, new Quote -> ISSUED, both preserved) —
// WITHDRAWN remains unused, still reserved for a later milestone.
// ---------------------------------------------------------------------------

enum QuotationOrigin {
  INSTANT
  CUSTOM_SOURCING
}

enum QuotationStatus {
  ISSUED
  ACCEPTED
  EXPIRED
  SUPERSEDED
}

/// An issued, immutable commercial offer. Once ISSUED, its QuotationItems
/// never change — a later listing price/tier change never rewrites an
/// already-issued quotation (see docs/workflows/workflows.md). `status`
/// transitions are server-enforced only: ISSUED -> ACCEPTED (via
/// ordersService.createOrderFromQuotation, atomically with Order creation);
/// ISSUED -> EXPIRED is derived at read time from `expiresAt` rather than a
/// background sweep — acceptance independently re-checks expiry, so
/// correctness never depends on a scheduler running. ISSUED -> SUPERSEDED
/// happens only when staff reissues a CUSTOM_SOURCING quote with revised
/// terms (M6) — the old row is never edited in place.
model Quotation {
  id        String          @id @default(cuid())
  /// Customer-facing identifier — never expose the raw id as the only
  /// reference (see lib/quote-number.ts).
  reference String          @unique
  origin    QuotationOrigin @default(INSTANT)
  status    QuotationStatus @default(ISSUED)

  currency String  @default("GHS")
  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  /// Present only for CUSTOM_SOURCING-origin quotes — nullable so M5's
  /// INSTANT path is entirely unaffected. Not unique: a revised/reissued
  /// quote points at the same request as its superseded predecessor.
  sourcingRequestId String?
  sourcingRequest   CustomSourcingRequest? @relation(fields: [sourcingRequestId], references: [id])

  /// Self-reference for the reissue trail (M6) — the OLD quote this one
  /// replaces. `@unique` because a given superseded quote can be replaced
  /// by at most one successor.
  supersedesQuotationId String?    @unique
  supersedes            Quotation? @relation("QuotationSupersedes", fields: [supersedesQuotationId], references: [id])
  supersededBy          Quotation? @relation("QuotationSupersedes")

  items QuotationItem[]
  order Order?

  @@index([customerProfileId])
  @@index([status])
  @@index([sourcingRequestId])
  /// Backs the M8 admin-dashboard custom-quote nearing-expiry attention query.
  @@index([status, expiresAt])
  @@map("quotation")
}

/// Never independently re-priced — snapshotted once at Quotation issuance
/// from live VendorListing/BulkPriceTier/VendorCostRule (INSTANT) or from
/// staff-curated SourcingAllocations (CUSTOM_SOURCING), then read-only.
/// `listingId` is always null for a CUSTOM_SOURCING line (no VendorListing
/// backing, even when internally sourced via one — see
/// docs/workflows/workflows.md Workflow R). `vendorId` is populated
/// internally ONLY when 100% of a custom line's supply traces to one
/// marketplace Vendor (this is what lets the existing, unmodified
/// confirmOrderPayment auto-create a Fulfilment for it) — the customer-
/// facing DTO masks vendor attribution entirely for CUSTOM_SOURCING quotes
/// regardless of this internal value (modules/quotation/service.ts).
model QuotationItem {
  id                 String  @id @default(cuid())
  description        String
  quantity           Int
  unitPrice          Decimal @db.Decimal(12, 2)
  /// Vendor-payable snapshot — never selected on any customer-facing DTO.
  vendorPayableBasis Decimal @db.Decimal(12, 2)
  lineTotal          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  listingId String?
  listing   VendorListing? @relation(fields: [listingId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  @@index([quotationId])
  @@map("quotation_item")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

/// What CrownSourceGlobal sold the customer. `status` (fulfilment track)
/// and `paymentStatus` are tracked separately per the approved state
/// machine — a COMPLETED order can still carry a REFUNDED paymentStatus.
model Order {
  id            String             @id @default(cuid())
  orderNumber   String             @unique
  status        OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus OrderPaymentStatus @default(UNPAID)

  currency String  @default("GHS")
  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  deliveryInfo Json

  /// Set once Fulfilments have been created for this order's confirmation —
  /// the idempotency marker called for in docs/domain/state-machines.md
  /// ("Fulfilment creation is idempotent per Order-confirmation event").
  fulfilmentsCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  /// Set only for a Quotation-origin Order (cart-origin orders leave this
  /// null). The `@unique` constraint IS the "at most one Order per
  /// Quotation, ever" guarantee — double-acceptance (double-click, retry,
  /// concurrent tab) cannot produce two Orders even under a race, without a
  /// separate IdempotencyKey scope (see modules/orders/service.ts
  /// createOrderFromQuotation).
  originQuotationId String?    @unique
  originQuotation   Quotation? @relation(fields: [originQuotationId], references: [id])

  items           OrderItem[]
  fulfilments     Fulfilment[]
  payments        Payment[]
  reservations    InventoryReservation[]
  conversations   Conversation[]
  resolutionCases ResolutionCase[]
  refunds         Refund[]
  vendorEarnings  VendorEarning[]

  @@index([customerProfileId])
  /// Backs the M8 admin-dashboard "Today" KPI queries (status + date range).
  @@index([status, createdAt])
  @@map("order")
}

/// The first point standard-path pricing becomes authoritative (see
/// docs/workflows/workflows.md). `description`/`unitPrice` are snapshotted
/// values, independent of the live VendorListing from this point on.
model OrderItem {
  id                 String  @id @default(cuid())
  description        String
  quantity           Int
  unitPrice          Decimal @db.Decimal(12, 2)
  /// What CrownSourceGlobal owes the vendor for this line (vendor supply
  /// cost x quantity, snapshotted from VendorCostRule at order-creation
  /// time) — never derived from live VendorCostRule again after this.
  vendorPayableBasis Decimal @db.Decimal(12, 2)
  lineTotal          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  listingId String?
  listing   VendorListing? @relation(fields: [listingId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  fulfilmentItems        FulfilmentItem[]
  vendorEarnings         VendorEarning[]
  /// This item as the affected line in a post-purchase case (M9).
  resolutionCaseItems    ResolutionCaseItem[]
  /// This item as the ORIGINAL line a Replacement (M9) replaces — named
  /// relation since Replacement also references a second, newly-created
  /// OrderItem below.
  replacementsAsOriginal Replacement[]        @relation("ReplacementOriginalItem")
  /// This item AS a replacement's own zero-value line (M9) — see Replacement.
  replacementAsNewItem   Replacement?         @relation("ReplacementNewItem")

  @@index([orderId])
  @@map("order_item")
}

enum FulfilmentStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  COMPLETED
  EXCEPTION
  CANCELLED
}

/// Which physical route a Fulfilment takes to reach the customer — decided
/// once, at Fulfilment-creation time, from the vendor's country at that
/// moment (never re-derived later, same snapshot philosophy as
/// OrderItem/FulfilmentItem pricing). Domestic vendors hand off to a
/// CrownSource-arranged local collection; international vendors ship to a
/// CrownSource-designated Ghana ReceivingLocation first. Keeping this as an
/// explicit field — rather than checking vendor.country throughout the UI —
/// is what lets M4 UI/services branch on origin without hard-coding country
/// logic in multiple places (see docs/domain/entities.md M4 addendum).
enum FulfilmentOrigin {
  DOMESTIC_COLLECTION
  INTERNATIONAL_INBOUND
}

/// Vendor-scoped responsibility for a subset of an Order. No uniqueness
/// constraint on (orderId, vendorId) — multiple Fulfilments per vendor per
/// Order are legal (future partial/split fulfilment), per entities.md.
model Fulfilment {
  id        String           @id @default(cuid())
  status    FulfilmentStatus @default(PENDING)
  origin    FulfilmentOrigin
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  items           FulfilmentItem[]
  issues          FulfilmentIssue[]
  shipments       Shipment[]
  /// Cases whose primary operational context is this Fulfilment (M9) —
  /// a case's detailed item/quantity breakdown lives on ResolutionCaseItem
  /// regardless; this is a convenience pointer, not the source of truth.
  resolutionCases ResolutionCase[]
  vendorEarnings  VendorEarning[]

  @@index([orderId])
  @@index([vendorId])
  @@index([vendorId, status])
  /// Backs the admin Operations queue — filtered by status without a vendor.
  @@index([status])
  /// Backs the M8 admin-dashboard "overdue" attention query (status +
  /// how long it's been sitting there).
  @@index([status, updatedAt])
  @@map("fulfilment")
}

enum FulfilmentIssueStatus {
  OPEN
  RESOLVED
}

/// The M4 "operational exception boundary" — a vendor-reportable problem
/// that pauses a Fulfilment (status flips to EXCEPTION) for CrownSource
/// operations to resolve. Deliberately does not touch OrderItem, payment
/// amounts, or quantities — a real refund/replacement/quantity-adjustment
/// platform is out of scope for M4 (see CLAUDE.md's overengineering rule).
model FulfilmentIssue {
  id          String                @id @default(cuid())
  status      FulfilmentIssueStatus @default(OPEN)
  category    String
  description String

  reportedByUserId String
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNotes  String?

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId])
  @@index([status])
  @@map("fulfilment_issue")
}

/// Never independently authoritative — always copies its economics from
/// the parent OrderItem at Fulfilment-creation time, no new pricing
/// evaluation (docs/workflows/workflows.md). `payoutHold`/`payoutHoldReason`
/// are set by resolutionsService.approveResolution() (M9) and read as one
/// input to VendorEarning's own eligibility computation (M11) — the actual
/// payable lifecycle lives on VendorEarning, not here (the never-populated
/// `payoutEligibility` field this milestone removed was dead weight from
/// the pre-implementation planning pass; VendorEarning.status supersedes
/// it, see docs/decisions/0009-vendor-earnings-and-settlement.md).
model FulfilmentItem {
  id                 String   @id @default(cuid())
  quantity           Int
  unitPrice          Decimal  @db.Decimal(12, 2)
  vendorPayableBasis Decimal  @db.Decimal(12, 2)
  payoutHold         Boolean  @default(false)
  payoutHoldReason   String?
  createdAt          DateTime @default(now())

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  resolutionCaseItems ResolutionCaseItem[]
  vendorEarning       VendorEarning?

  @@index([fulfilmentId])
  @@index([orderItemId])
  @@map("fulfilment_item")
}

/// A CrownSource-controlled physical receiving point for international
/// inbound Fulfilments — an office, warehouse, consolidation facility, or
/// 3PL partner. Never assume there is exactly one; operations assigns the
/// appropriate one per Shipment. Private/admin-only — never on any public
/// DTO (this is operational infrastructure, not a storefront address).
model ReceivingLocation {
  id     String  @id @default(cuid())
  name   String
  type   String? // free text: "office" | "warehouse" | "consolidation" | "freight_forwarder" | ...
  active Boolean @default(true)

  country      String
  region       String?
  city         String?
  addressLine1 String

  contactName  String?
  contactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@index([active])
  @@map("receiving_location")
}

enum ShipmentStatus {
  CREATED
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  EXCEPTION
}

/// Physical movement of goods — distinct from Fulfilment (vendor
/// responsibility) and Order (commercial purchase), per entities.md's
/// existing separation. `fulfilmentId` is intentionally NOT unique: the V1
/// path is exactly one Shipment per Fulfilment, but leaving this
/// unconstrained means a future partial-shipment split (one Fulfilment,
/// several Shipments) needs no schema change. True consolidation (several
/// Fulfilments sharing one Shipment) would still need a join table later —
/// documented as a future path, not built now.
///
/// CrownSource/logistics-controlled fields only — nothing here is ever
/// vendor- or customer-writable directly; see modules/fulfilment/policy.ts.
model Shipment {
  id     String         @id @default(cuid())
  status ShipmentStatus @default(CREATED)

  carrier           String?
  trackingReference String?

  /// Domestic collection — set by CrownSource operations once the vendor
  /// marks READY.
  collectionScheduledAt DateTime?
  collectionNotes       String?
  collectedAt           DateTime?
  collectedByUserId     String?

  /// International inbound — shippedAt/expectedArrivalAt are vendor-
  /// entered; receivedAt/receivedByUserId are CrownSource-confirmed only.
  receivingLocationId String?
  receivingLocation   ReceivingLocation? @relation(fields: [receivingLocationId], references: [id])
  shippedAt           DateTime?
  expectedArrivalAt   DateTime?
  receivedAt          DateTime?
  receivedByUserId    String?

  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  deliveryFailedAt DateTime?
  deliveryNotes    String?

  /// An additional signal only — never the sole authoritative delivery
  /// confirmation (CLAUDE.md / M4 brief: a customer action must never
  /// itself set `status = DELIVERED`).
  customerConfirmedReceiptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId])
  @@index([status])
  @@index([trackingReference])
  @@map("shipment")
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  /// Customer-abandoned or provider-declined-as-cancelled, distinct from a
  /// technical/system FAILED — introduced M10A alongside the first real
  /// (async) provider. Terminal, same as FAILED.
  CANCELLED
}

enum PaymentProviderName {
  MOCK
  /// Experimental/deferred as of M10A.2 — Paystack is now the primary real
  /// provider. Kept selectable for development/experimental testing only;
  /// never routed to for production payments. See docs/decisions/0007.
  MOOLRE
  /// Primary real payment provider as of M10A.2.
  PAYSTACK
}

enum PaymentMethod {
  MOCK
  MOBILE_MONEY
  /// Paystack-hosted Checkout/Popup only (M10B) — CrownSourceGlobal never
  /// receives PAN/CVV/PIN/OTP. `network` is always null for this method.
  CARD
}

/// Ghana Mobile Money networks — shared across providers (Moolre, Paystack).
/// Provider-specific channel/provider codes are mapped inside each
/// provider's own adapter, never here.
enum PaymentNetwork {
  MTN
  TELECEL
  AT
}

/// M10A generalized this model for a real, asynchronous provider (Moolre,
/// M10A) while keeping MockPaymentProvider's synchronous rows fully valid.
/// M10A.2 pivoted the primary real provider to Paystack, adding
/// `providerReference` — Moolre remains selectable (experimental/deferred).
model Payment {
  id                String              @id @default(cuid())
  /// CrownSourceGlobal's own reference (PAY-YYYYMMDD-XXXXX), never the
  /// provider's identity. Also sent to Moolre as `externalref` — the one
  /// idempotency key that must never be regenerated on a same-attempt retry.
  reference         String              @unique
  provider          PaymentProviderName @default(MOCK)
  method            PaymentMethod       @default(MOCK)
  /// Only meaningful when method = MOBILE_MONEY.
  network           PaymentNetwork?
  status            PaymentStatus       @default(INITIATED)
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("GHS")
  /// The provider's own TRANSACTION identifier (Paystack's `data.id`;
  /// Moolre's genuine TR099/status `transactionid` — never a non-identifying
  /// placeholder like Moolre's TP14/TP17 `"all"`, see docs/decisions/0006).
  /// Never our primary identity — Order confirmation always keys off this
  /// row's own `reference` instead. Added M10A.2, replacing the overloaded
  /// use of `providerEventId` below (docs/decisions/0007).
  providerReference String?             @unique
  /// Reserved for a genuine provider webhook/EVENT identity, distinct from
  /// the transaction itself — NOT currently populated by any adapter.
  /// Originally misused to store Moolre's transaction identity; that usage
  /// was migrated to `providerReference` above (docs/decisions/0007). Kept,
  /// unused, for a future provider that has a real, separate event id.
  providerEventId   String?             @unique
  /// Last raw provider status code observed (e.g. "TR099"/"SS01") — for
  /// admin diagnostics only, never interpreted by domain code.
  providerStatus    String?
  /// Set whenever we independently re-verify status via the provider's
  /// status API (webhook trigger, poll, or admin reconciliation).
  lastVerifiedAt    DateTime?
  /// Customer-safe failure copy, never a raw provider error string.
  failureReasonSafe String?
  /// Masked display value only (e.g. "024***1234") — the raw phone is never
  /// persisted once the provider request has been sent.
  phoneMasked       String?
  /// Card payments only (M10B) — Paystack's `card_type` (e.g. "visa"), set
  /// only on SUCCEEDED verification, never the PAN/CVV/PIN/OTP.
  cardBrand         String?
  /// Card payments only (M10B) — last 4 digits only, set only on SUCCEEDED
  /// verification.
  cardLast4         String?
  /// Which attempt number this is for the parent Order — multiple Payment
  /// rows may exist per Order, history is never mutated in place.
  attemptNumber     Int                 @default(1)
  /// Non-null marks this Payment as needing staff attention (amount/currency
  /// mismatch, late-success-after-reservation-expiry, repeated
  /// reconciliation failure, etc.) — a derived-query marker, not a new
  /// state-machine value, per M8's "derived attention item" philosophy.
  exceptionReason   String?
  initiatedAt       DateTime            @default(now())
  confirmedAt       DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  refunds Refund[]
  // NOTE (DB-only, not expressible here): a partial unique index enforces at
  // most one active (INITIATED/PENDING) Payment per Order —
  // CREATE UNIQUE INDEX payment_one_active_per_order ON payment(orderId)
  // WHERE status IN ('INITIATED','PENDING'). See the M10A migration.

  @@index([orderId])
  @@index([status])
  @@index([exceptionReason])
  @@map("payment")
}

enum ReservationStatus {
  HELD
  RELEASED
  COMMITTED
}

/// Reservation is an atomic conditional decrement of
/// VendorListing.availableQuantity, created in the same transaction as the
/// PENDING_PAYMENT Order (docs/workflows/workflows.md Workflow G).
model InventoryReservation {
  id        String            @id @default(cuid())
  quantity  Int
  status    ReservationStatus @default(HELD)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  listingId String
  listing   VendorListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([orderId])
  @@map("inventory_reservation")
}

enum IdempotencyScope {
  CHECKOUT
  PAYMENT
}

/// Backs the "double-click Pay" / duplicate-submission protection required
/// by CLAUDE.md's commerce-integrity rules. `resultRef` points at the
/// entity the first successful attempt produced (a Payment id for the
/// PAYMENT scope).
model IdempotencyKey {
  id        String           @id @default(cuid())
  key       String           @unique
  scope     IdempotencyScope
  resultRef String
  createdAt DateTime         @default(now())

  @@map("idempotency_key")
}

/// CrownSourceGlobal-owned (M13). Backs lib/rate-limit.ts's fixed-window
/// limiter for high-risk server actions Better Auth's own rate limiter
/// doesn't cover (payment/OTP initiation, checkout order creation) — see
/// docs/decisions/0011-production-infrastructure-m13.md. Deliberately a
/// separate table from Better Auth's own `RateLimit` above: that table is
/// Better Auth-owned and only Better Auth's request lifecycle writes to it.
model ActionRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("action_rate_limit")
}

// ---------------------------------------------------------------------------
// M9 — Post-Purchase Resolution (cancellations, returns, replacements,
// refund decisions)
//
// The central principle: one failed/damaged/wrong OrderItem never forces a
// whole multi-vendor Order into a binary refunded/not-refunded state.
// Resolution happens at the OrderItem/quantity level (ResolutionCaseItem),
// never `order.refunded = true`. CrownSource staff is the sole decision
// authority throughout — a Customer can only REQUEST a resolution, a Vendor
// can only RESPOND to an operational request; neither can set financial
// state, approve anything, or communicate with the other directly (reusing
// M3 messaging's Customer↔CrownSource / Vendor↔CrownSource separation via a
// new RESOLUTION_CASE conversation context, never a shared thread).
//
// Refund is a DECISION record here (M9) — real money does not move.
// MockRefundExecutor (modules/refunds/mockExecutor.ts) stands in for a
// future production refund-provider call, mirroring the exact same
// provider-abstraction philosophy as MockPaymentProvider (M2/M3). Vendor
// payout correction is out of scope (nothing has ever been paid out yet —
// see ADR 0005); M9 only ever SETS/CLEARS the FulfilmentItem.payoutHold
// mechanism ADR 0005 already built for exactly this purpose, never
// PayoutAdjustment (which only makes sense once a PayoutRun has executed).
// ---------------------------------------------------------------------------

enum ResolutionCaseStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_CUSTOMER
  AWAITING_VENDOR
  RESOLUTION_APPROVED
  RESOLUTION_IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum ResolutionIssueType {
  CUSTOMER_CANCELLATION_REQUEST
  VENDOR_CANNOT_FULFIL
  ITEM_DAMAGED
  WRONG_ITEM
  MISSING_ITEM
  MISSING_QUANTITY
  ITEM_NOT_AS_DESCRIBED
  PACKAGE_NOT_RECEIVED
  DELIVERY_FAILURE
  OTHER
}

/// The customer's stated preference — a request, never an entitlement. Only
/// `ResolutionCaseItem.approvedResolution` (a ResolutionDecision, staff-set)
/// ever has financial/operational effect.
enum RequestedResolution {
  CANCELLATION
  REFUND
  PARTIAL_REFUND
  REPLACEMENT
  REDELIVERY
  OTHER
}

/// Staff's approved outcome for one ResolutionCaseItem. Deliberately the
/// smallest set that covers every flow in this milestone's brief — not one
/// enum value per issue-type/outcome combination.
enum ResolutionDecision {
  NO_ACTION
  FULL_REFUND
  PARTIAL_REFUND
  REPLACEMENT
  RETURN_AND_REFUND
  RETURN_AND_REPLACEMENT
  REDELIVERY
}

/// Internal-only fault attribution for a case — NEVER on any customer/vendor
/// DTO, email, or notification (CLAUDE.md's "internal liability decision
/// stays internal"). Feeds the FulfilmentItem.payoutHold decision; never
/// auto-derived from issueType — always an explicit staff judgment call.
enum ResolutionResponsibility {
  VENDOR
  CROWNSOURCE
  LOGISTICS
  CUSTOMER
  EXTERNAL_SUPPLIER
  SHARED_OTHER
}

/// Order-scoped (not a global flag) — an Order can have zero, one, or many
/// cases, each covering a subset of its OrderItems/quantities via
/// ResolutionCaseItem. `fulfilmentId` is a convenience "primary context"
/// pointer for cases fundamentally about one Fulfilment (VENDOR_CANNOT_FULFIL,
/// PACKAGE_NOT_RECEIVED, DELIVERY_FAILURE) — the authoritative line/quantity
/// breakdown always lives on ResolutionCaseItem, never here.
model ResolutionCase {
  id         String               @id @default(cuid())
  caseNumber String               @unique
  status     ResolutionCaseStatus @default(OPEN)
  issueType  ResolutionIssueType

  requestedResolution RequestedResolution?

  /// Customer-authored — what went wrong, in their own words.
  customerDescription        String
  /// Staff-authored, shown to the customer explaining the outcome — same
  /// "explicitly customer-safe, labeled as such in the admin form" pattern
  /// as vendor-application/listing decisionReason (M3) and sourcing's
  /// unableToSourceReason (M6).
  customerSafeDecisionReason String?

  /// Internal-only fault attribution — never customer/vendor-visible. See
  /// the ResolutionResponsibility doc comment above.
  responsibility ResolutionResponsibility?

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  fulfilmentId String?
  fulfilment   Fulfilment? @relation(fields: [fulfilmentId], references: [id])

  assignedStaffId String?
  assignedStaff   AdminUser? @relation(fields: [assignedStaffId], references: [id])

  items                ResolutionCaseItem[]
  attachments          ResolutionCaseAttachment[]
  activities           ResolutionCaseActivity[]
  refunds              Refund[]
  returns              Return[]
  replacements         Replacement[]
  conversations        Conversation[]
  financialAdjustments VendorFinancialAdjustment[]
  heldVendorEarnings   VendorEarning[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  @@index([customerProfileId, createdAt])
  @@index([status, createdAt])
  @@index([assignedStaffId, status])
  @@index([orderId])
  @@map("resolution_case")
}

/// The line/quantity-level resolution unit — this is where M9's central
/// "never order.refunded = true" principle actually lives. One case may
/// have several of these (multi-line partial resolution); one OrderItem may
/// appear across several cases over time (each case's own
/// approvedRefundAmount is capped server-side against the item's remaining
/// refundable value — see modules/refunds/policy.ts).
model ResolutionCaseItem {
  id String @id @default(cuid())

  resolutionCaseId String
  resolutionCase   ResolutionCase @relation(fields: [resolutionCaseId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  /// Nullable defensively (a case could in principle be opened before this
  /// item's Fulfilment context is resolved) — Fulfilments exist by the time
  /// any real case is created in practice (created at Order confirmation).
  fulfilmentItemId String?
  fulfilmentItem   FulfilmentItem? @relation(fields: [fulfilmentItemId], references: [id])

  quantityAffected Int

  issueType            ResolutionIssueType
  requestedResolution  RequestedResolution?
  approvedResolution   ResolutionDecision?
  /// Server-computed only — never trusts a client-submitted total. Capped
  /// so that cumulative approved amount for one OrderItem, across every
  /// case that has ever touched it, never exceeds that item's paid value.
  approvedRefundAmount Decimal?             @db.Decimal(12, 2)
  replacementQuantity  Int?

  /// Which Refund execution (if any) this line's approved amount was
  /// included in. Nullable until a Refund is actually created for it.
  refundId String?
  refund   Refund? @relation(fields: [refundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolutionCaseId])
  @@index([orderItemId])
  @@map("resolution_case_item")
}

/// Evidence — reuses the exact M6 storage architecture (lib/storage.ts,
/// lib/attachment-validation.ts): same MIME/magic-byte validation, same
/// randomized opaque storage keys, same private-download-only access
/// pattern. No second file-storage abstraction.
model ResolutionCaseAttachment {
  id String @id @default(cuid())

  resolutionCaseId String
  resolutionCase   ResolutionCase @relation(fields: [resolutionCaseId], references: [id], onDelete: Cascade)

  storageKey       String
  filename         String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String
  createdAt        DateTime @default(now())

  @@index([resolutionCaseId])
  @@map("resolution_case_attachment")
}

/// Lightweight timeline, mirroring SourcingRequestActivity (M6) exactly —
/// not event sourcing. Also carries staff-only internal notes as
/// `type: "internal_note"` entries (metadata.note) rather than a second,
/// redundant notes table — this activity log is ALREADY never
/// customer/vendor-visible, so it's the natural home for them.
model ResolutionCaseActivity {
  id String @id @default(cuid())

  resolutionCaseId String
  resolutionCase   ResolutionCase @relation(fields: [resolutionCaseId], references: [id], onDelete: Cascade)

  type        String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([resolutionCaseId, createdAt])
  @@map("resolution_case_activity")
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

/// The REFUND DECISION, not its execution against a real payment provider
/// (deferred to M10 — see modules/refunds/mockExecutor.ts). `amount` is
/// always itemsAmount + deliveryFeeAmount, both server-computed/validated —
/// never a client-submitted total (CLAUDE.md's "never trust client-supplied
/// financial totals"). `providerEventId` gives the same idempotent-retry
/// shape MockPaymentProvider already established for charges.
model Refund {
  id String @id @default(cuid())

  resolutionCaseId String
  resolutionCase   ResolutionCase @relation(fields: [resolutionCaseId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  /// Sum of the covered ResolutionCaseItems' approvedRefundAmount.
  itemsAmount       Decimal @db.Decimal(12, 2)
  /// Explicit staff decision only (see docs/architecture/overview.md) — a
  /// delivery/shipping fee is never refunded automatically.
  deliveryFeeAmount Decimal @default(0) @db.Decimal(12, 2)
  /// itemsAmount + deliveryFeeAmount — the actual amount executed.
  amount            Decimal @db.Decimal(12, 2)
  currency          String  @default("GHS")

  status          RefundStatus @default(PENDING_APPROVAL)
  /// The refund executor's own reference for this refund (e.g. Paystack's
  /// refund `id`/reference) — never populated by MoolreRefundExecutor
  /// (always fails closed) or a failed MockRefundExecutor attempt.
  providerEventId String?      @unique
  approvedAt      DateTime?
  processedAt     DateTime?
  failureReason   String?

  items ResolutionCaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([resolutionCaseId])
  @@map("refund")
}

enum ReturnStatus {
  APPROVED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  COMPLETED
}

enum ReturnInspectionOutcome {
  RESELLABLE
  NOT_RESELLABLE
}

/// CrownSource-managed reverse logistics only — the Customer is never
/// instructed to deal with the Vendor directly. Manual
/// method/trackingReference entry for V1, no courier API (same "manual is
/// sufficient for V1" reasoning as M4's domestic collection). `restockedAt`
/// is the idempotency marker for the one-time inventory restock decision —
/// restocking is never inferred merely from a refund being approved, only
/// from an explicit RESELLABLE inspection outcome.
model Return {
  id String @id @default(cuid())

  resolutionCaseId String
  resolutionCase   ResolutionCase @relation(fields: [resolutionCaseId], references: [id])

  status ReturnStatus @default(APPROVED)

  method            String?
  trackingReference String?
  notes             String?

  receivedAt        DateTime?
  inspectedAt       DateTime?
  inspectionOutcome ReturnInspectionOutcome?
  /// Set once, guarded — the idempotency marker preventing a double-restock
  /// if the same Return is ever touched twice.
  restockedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([resolutionCaseId])
  @@map("return")
}

/// A thin link record, not a parallel tracking system — the replacement's
/// actual delivery is tracked entirely via the ordinary Fulfilment/Shipment
/// machinery (modules/resolutions/service.ts creates a zero-value OrderItem
/// + Fulfilment + FulfilmentItem + Shipment using the exact same shape
/// confirmOrderPayment already uses for a normal order — see
/// docs/workflows/workflows.md). No fake customer charge: the replacement
/// OrderItem's unitPrice/lineTotal/vendorPayableBasis are always zero.
model Replacement {
  id String @id @default(cuid())

  resolutionCaseId String
  resolutionCase   ResolutionCase @relation(fields: [resolutionCaseId], references: [id])

  originalOrderItemId String
  originalOrderItem   OrderItem @relation("ReplacementOriginalItem", fields: [originalOrderItemId], references: [id])

  quantity Int

  /// Populated once the replacement's zero-value OrderItem (and, from it,
  /// Fulfilment/FulfilmentItem/Shipment) has actually been created.
  replacementOrderItemId String?    @unique
  replacementOrderItem   OrderItem? @relation("ReplacementNewItem", fields: [replacementOrderItemId], references: [id])

  createdAt DateTime @default(now())

  @@index([resolutionCaseId])
  @@map("replacement")
}

// ---------------------------------------------------------------------------
// M3 — Vendor onboarding, VendorMembership, admin, messaging
//
// A VendorApplication is the private onboarding/moderation record; Vendor
// itself (above) is only created once an application is APPROVED, keeping
// the lean, partially-public Vendor row separate from private application
// data (CLAUDE.md's "public vs private vendor information" boundary).
// Conversation/Message implement the two structurally-separate managed
// messaging shapes (Customer<->CSG, Vendor<->CSG) — there is deliberately no
// participant shape that lets a buyer and a vendor share a thread.
// ---------------------------------------------------------------------------

enum SellerType {
  INDIVIDUAL
  SOLE_TRADER
  REGISTERED_BUSINESS
  DISTRIBUTOR_WHOLESALER
  MANUFACTURER
  ORGANIZATION
  OTHER
}

enum VendorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

/// One application per User, ever (see modules/vendor-applications) — reused
/// across resubmission after CHANGES_REQUESTED/REJECTED rather than creating
/// a new row, so "leave and resume" and "edit after rejection" are the same
/// mechanism. Approval creates the Vendor row and an OWNER VendorMembership
/// in one transaction.
model VendorApplication {
  id     String                  @id @default(cuid())
  status VendorApplicationStatus @default(DRAFT)

  sellerType SellerType?

  contactName  String?
  contactEmail String?
  contactPhone String?

  displayName        String?
  legalName          String?
  storeDescription   String?
  registrationNumber String?
  taxIdentifier      String?
  yearEstablished    Int?
  websiteUrl         String?

  country      String?
  region       String?
  city         String?
  addressLine1 String?

  categorySlugs       String[] @default([])
  sellingMode         String?
  bulkCapable         Boolean  @default(false)
  leadTimeDaysDefault Int?
  serviceAreas        String?

  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewerUserId String?
  /// Shown to the applicant when status = CHANGES_REQUESTED or REJECTED.
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicantUserId String @unique
  applicant       User   @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)

  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  @@index([status])
  /// Backs the M8 admin-dashboard vendor-application attention/ageing query.
  @@index([status, submittedAt])
  @@map("vendor_application")
}

enum VendorMembershipRole {
  OWNER
  STAFF
}

/// Only a valid VendorMembership grants Vendor Portal access to that Vendor
/// — never derived from anything else. M3 does not differentiate OWNER vs
/// STAFF capabilities yet (all members can manage listings); the role field
/// exists so that differentiation can be added later without a schema
/// change (CLAUDE.md's "capable of supporting multiple users per Vendor").
model VendorMembership {
  id        String               @id @default(cuid())
  role      VendorMembershipRole @default(OWNER)
  createdAt DateTime             @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([vendorId])
  @@map("vendor_membership")
}

enum AdminRole {
  SUPER_ADMIN
  OPS_ADMIN
  FINANCE_ADMIN
}

/// Grants CrownSourceGlobal staff access — created only via the dev-only
/// `npm run admin:grant` CLI script (see scripts/grant-admin.ts), never via
/// a public route or a hardcoded email. Only SUPER_ADMIN/OPS_ADMIN have any
/// capability wired up in M3 (vendor/listing moderation, managed messaging);
/// FINANCE_ADMIN is modeled per the approved 3-role split but unused until
/// payments/payouts admin work exists.
model AdminUser {
  id        String    @id @default(cuid())
  role      AdminRole
  createdAt DateTime  @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedSourcingRequests CustomSourcingRequest[]
  assignedResolutionCases  ResolutionCase[]

  @@map("admin_user")
}

enum ConversationParticipantType {
  CUSTOMER
  VENDOR
}

enum ConversationContextType {
  LISTING
  VENDOR
  ORDER
  SOURCING_REQUEST
  RESOLUTION_CASE
  GENERAL
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/// The non-CrownSource party is either `customerProfileId` (participantType
/// CUSTOMER) or `vendorId` (participantType VENDOR) — never both, and there
/// is no field that could make a vendor a participant in a customer thread.
/// `contextVendorId`/`contextListingId`/`contextOrderId` describe what a
/// CUSTOMER conversation is *about* (e.g. "asking about this listing") —
/// this is metadata for CrownSource staff, not a grant of vendor visibility.
model Conversation {
  id              String                      @id @default(cuid())
  participantType ConversationParticipantType
  contextType     ConversationContextType     @default(GENERAL)
  status          ConversationStatus          @default(OPEN)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation("VendorParticipantConversations", fields: [vendorId], references: [id], onDelete: Cascade)

  contextListingId String?
  contextListing   VendorListing? @relation(fields: [contextListingId], references: [id])

  contextVendorId String?
  contextVendor   Vendor? @relation("ConversationContextVendor", fields: [contextVendorId], references: [id])

  contextOrderId String?
  contextOrder   Order?  @relation(fields: [contextOrderId], references: [id])

  contextSourcingRequestId String?
  contextSourcingRequest   CustomSourcingRequest? @relation(fields: [contextSourcingRequestId], references: [id])

  /// (M9) What a case-related conversation is about — valid for BOTH
  /// participant types, unlike the other context fields above which only
  /// ever populate on CUSTOMER conversations. This is what gives a
  /// ResolutionCase two structurally separate threads (Customer↔CrownSource
  /// and Vendor↔CrownSource) rather than one shared one.
  contextResolutionCaseId String?
  contextResolutionCase   ResolutionCase? @relation(fields: [contextResolutionCaseId], references: [id])

  messages Message[]

  @@index([customerProfileId])
  @@index([vendorId])
  /// Backs the staff inbox — filtered by status, ordered by recency.
  @@index([status, updatedAt])
  @@index([contextResolutionCaseId])
  @@map("conversation")
}

model Message {
  id            String   @id @default(cuid())
  body          String
  /// Snapshotted at send time — true when the sender was CrownSource staff
  /// replying (customer/vendor side is always false), independent of the
  /// AdminUser table so a later staff-role change never rewrites history.
  senderIsStaff Boolean  @default(false)
  createdAt     DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUserId String
  senderUser   User   @relation(fields: [senderUserId], references: [id])

  /// Covers "messages for this conversation, chronological" without a
  /// separate sort step — the shape of every message-history query.
  @@index([conversationId, createdAt])
  @@map("message")
}

// ---------------------------------------------------------------------------
// M6 — Custom Sourcing & Managed Procurement
//
// The third purchasing path (Workflow R): a requirement that cannot be
// resolved deterministically from existing catalogue/pricing data (unlike
// M5's instant quotations) goes through a human-operated CrownSource
// sourcing workflow instead. There is deliberately no persisted DRAFT
// request row — same reasoning as M5's Quotation: submission is atomic, no
// commercial commitment exists before it.
//
// The customer relationship is always Customer <-> CrownSourceGlobal, never
// Customer <-> Supplier — SourcingOption/SourcingAllocation are internal
// CrownSource operational records, structurally invisible to any customer
// DTO (see modules/sourcing/types.ts's separate Admin* vs customer-facing
// view types, mirroring the same pattern already used for Fulfilment in M4
// and Quotation in M5).
// ---------------------------------------------------------------------------

enum SourcingRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  SOURCING
  AWAITING_CUSTOMER
  QUOTED
  ACCEPTED
  UNABLE_TO_SOURCE
  CANCELLED
}

/// The customer's managed-procurement requirement. `quantity` is a single
/// figure for a single requirement — M6 does not support multi-line custom
/// requests (a customer with two distinct requirements submits two
/// requests), which is why a resulting CUSTOM_SOURCING Quotation always has
/// exactly one QuotationItem.
model CustomSourcingRequest {
  id            String                @id @default(cuid())
  /// Customer-facing identifier — see lib/sourcing-number.ts.
  requestNumber String                @unique
  status        SourcingRequestStatus @default(SUBMITTED)

  title        String
  description  String
  quantity     Int
  quantityUnit String?

  /// Flexible/freeform — size, color, model, material, brand, customization,
  /// packaging, etc. Deliberately a JSON bag rather than hard-coded columns
  /// per category (CLAUDE.md's "do not hard-code category-specific fields").
  specifications Json?

  requiredByDate  DateTime?
  deliveryCountry String
  deliveryRegion  String?
  deliveryCity    String?

  budgetAmount   Decimal? @db.Decimal(12, 2)
  budgetCurrency String?

  /// Customer-safe explanation only, shown when status = UNABLE_TO_SOURCE —
  /// the fuller internal reason (if staff want one) lives in
  /// SourcingRequestActivity, never here.
  unableToSourceReason String?

  submittedAt DateTime  @default(now())
  quotedAt    DateTime?
  /// Set when the request reaches any terminal state (ACCEPTED,
  /// UNABLE_TO_SOURCE, CANCELLED).
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  assignedStaffId String?
  assignedStaff   AdminUser? @relation(fields: [assignedStaffId], references: [id])

  attachments   SourcingRequestAttachment[]
  options       SourcingOption[]
  allocations   SourcingAllocation[]
  activities    SourcingRequestActivity[]
  quotations    Quotation[]
  conversations Conversation[]

  @@index([customerProfileId, createdAt])
  @@index([status, createdAt])
  @@index([assignedStaffId, status])
  @@map("custom_sourcing_request")
}

/// Metadata only — actual bytes live behind the StorageProvider abstraction
/// (lib/storage.ts), never in Postgres. `storageKey` is a randomized,
/// non-guessable reference; `filename` is a sanitized display-only value,
/// never used to construct a filesystem/storage path.
model SourcingRequestAttachment {
  id String @id @default(cuid())

  storageKey String
  filename   String
  mimeType   String
  sizeBytes  Int

  uploadedByUserId String
  createdAt        DateTime @default(now())

  sourcingRequestId String
  sourcingRequest   CustomSourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)

  @@index([sourcingRequestId])
  @@map("sourcing_request_attachment")
}

enum SourcingOptionSourceType {
  VENDOR_LISTING
  VENDOR
  EXTERNAL_SUPPLIER
}

/// An internal CrownSource-curated supply possibility for a request — never
/// exposed to the customer in any form (see modules/sourcing's Admin-only
/// types). Not every option references a VendorListing, or even a Vendor —
/// see docs/decisions and Workflow R for the three source shapes this
/// covers (existing listing, vendor without a public listing, off-platform
/// external supplier).
model SourcingOption {
  id String @id @default(cuid())

  sourceType SourcingOptionSourceType

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  vendorListingId String?
  vendorListing   VendorListing? @relation(fields: [vendorListingId], references: [id])

  /// Private — internal CrownSource operational information only, never on
  /// any customer DTO (CLAUDE.md's "no direct Customer<->Vendor/Supplier").
  externalSupplierName    String?
  externalSupplierContact String?

  quantityAvailable Int?
  proposedQuantity  Int
  unitSupplyCost    Decimal @db.Decimal(12, 2)
  currency          String  @default("GHS")
  leadTimeDays      Int?
  originCountry     String?
  /// Staff-only sourcing notes — never on any customer DTO.
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourcingRequestId String
  sourcingRequest   CustomSourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)

  allocations SourcingAllocation[]

  @@index([sourcingRequestId])
  @@map("sourcing_option")
}

/// A committed quantity+cost snapshot against one SourcingOption, at the
/// moment it's allocated — mirrors OrderItem/FulfilmentItem's "never derive
/// historical economics from mutable current data" snapshot philosophy.
/// Changing a SourcingOption's cost later never rewrites an allocation that
/// already contributed to an issued Quotation.
model SourcingAllocation {
  id String @id @default(cuid())

  allocatedQuantity      Int
  unitSupplyCostSnapshot Decimal @db.Decimal(12, 2)
  currency               String  @default("GHS")
  leadTimeDaysSnapshot   Int?
  originCountrySnapshot  String?

  createdAt DateTime @default(now())

  sourcingRequestId String
  sourcingRequest   CustomSourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)

  sourcingOptionId String
  sourcingOption   SourcingOption @relation(fields: [sourcingOptionId], references: [id])

  @@index([sourcingRequestId])
  @@index([sourcingOptionId])
  @@map("sourcing_allocation")
}

/// Lightweight, staff-only operational history — NOT event sourcing, no
/// customer-facing rendering of individual entries (the customer-facing
/// progress view is derived from status + a few key timestamps instead, see
/// modules/sourcing/service.ts) so there is no risk of an internal-cost
/// note ever leaking through an activity feed.
model SourcingRequestActivity {
  id String @id @default(cuid())

  type        String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  sourcingRequestId String
  sourcingRequest   CustomSourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)

  @@index([sourcingRequestId, createdAt])
  @@map("sourcing_request_activity")
}

// ---------------------------------------------------------------------------
// M7 — Notifications, Production Communications & User Attention
//
// The domain-event / communication-channel separation is structural, not
// just a convention: every M0–M6 module now calls
// modules/notifications/service.ts's `notify()` instead of touching
// lib/email.ts directly. `notify()` persists a Notification (always) and,
// only when the event type warrants it, an EmailDeliveryJob (durable,
// retryable) — never a synchronous provider call inside a request. A
// Notification's `recipientUserId` is deliberately a single User id (not a
// role-specific table) — a User who is Customer + Vendor owner + Admin sees
// one deduplicated stream, regardless of which portal shell renders it.
// ---------------------------------------------------------------------------

enum NotificationType {
  VENDOR_APPLICATION_SUBMITTED
  VENDOR_APPLICATION_APPROVED
  VENDOR_APPLICATION_CHANGES_REQUESTED
  VENDOR_APPLICATION_REJECTED
  LISTING_APPROVED
  LISTING_CHANGES_REQUESTED
  LISTING_REJECTED
  ORDER_CONFIRMED
  VENDOR_NEW_ORDER
  COLLECTION_SCHEDULED
  PACKAGE_COLLECTED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_ISSUE
  FULFILMENT_ISSUE_RESOLVED
  QUOTE_ISSUED
  SOURCING_REQUEST_SUBMITTED
  SOURCING_CLARIFICATION_NEEDED
  SOURCING_QUOTE_READY
  SOURCING_UNABLE_TO_SOURCE
  STAFF_REPLY
  VENDOR_STAFF_REPLY
  ADMIN_NEW_VENDOR_APPLICATION
  ADMIN_NEW_SOURCING_REQUEST
  ADMIN_NEW_MESSAGE
  RESOLUTION_CASE_RECEIVED
  RESOLUTION_CLARIFICATION_NEEDED
  RESOLUTION_APPROVED
  RETURN_APPROVED
  REFUND_APPROVED
  REFUND_COMPLETED
  REPLACEMENT_CREATED
  RESOLUTION_CASE_RESOLVED
  RESOLUTION_VENDOR_RESPONSE_NEEDED
  RESOLUTION_VENDOR_CASE_UPDATE
  ADMIN_NEW_RESOLUTION_CASE
  ADMIN_REFUND_FAILED
  PAYMENT_FAILED
  ADMIN_PAYMENT_REQUIRES_ATTENTION
  VENDOR_EARNING_ON_HOLD
  VENDOR_SETTLEMENT_APPROVED
  VENDOR_SETTLEMENT_PAID
}

/// A structured, typed in-app notification. `title`/`body` are plain text
/// (never raw HTML — CLAUDE.md's "do not persist arbitrary HTML" instinct
/// applied here), `targetUrl` is always an app-relative path built from
/// known route shapes in code (modules/notifications/links.ts), never
/// derived from a request Host header or client input — no open-redirect
/// surface. `eventKey` + the `(recipientUserId, eventKey)` unique
/// constraint is the dedup guarantee: a retried domain action (double-click,
/// duplicate webhook-equivalent call, worker retry) calling `notify()`
/// again for the same logical event is a caught no-op, never a duplicate
/// row — safe even when the same event fans out to many recipients (e.g.
/// one new sourcing request notifying every admin), since the key is scoped
/// per-recipient, not global.
model Notification {
  id String @id @default(cuid())

  recipientUserId String
  recipient       User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  targetUrl String

  eventKey String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  emailJob EmailDeliveryJob?

  @@unique([recipientUserId, eventKey])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notification")
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Durable, retryable email delivery — deliberately NOT a generic
/// BackgroundJob table (that would be speculative infrastructure for a
/// currently-single job type; see docs/architecture/overview.md). A worker
/// claims eligible rows via a guarded `updateMany` (status IN
/// (PENDING,FAILED) AND availableAt <= now), the same optimistic-claim
/// pattern already used for every state-machine transition in this
/// codebase — two concurrent worker runs can never double-send the same
/// job. `@@unique([notificationId])` makes a job 1:1 with its Notification,
/// so even a caller that accidentally invokes `notify()` twice for the same
/// event (already prevented by Notification's own dedup key) could never
/// produce two email jobs for one notification either.
model EmailDeliveryJob {
  id String @id @default(cuid())

  notificationId String?       @unique
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  to           String
  subject      String
  templateKey  String
  templateData Json

  status      EmailDeliveryStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  /// Bounded-backoff eligibility gate — never retried before this instant.
  availableAt DateTime            @default(now())
  lastError   String?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@map("email_delivery_job")
}

/// One row per User (not per role) — a User who is both a Customer and a
/// Vendor owner sets their email preferences once. Only gates the EMAIL
/// channel; in-app Notifications always fire regardless (see
/// modules/notifications/service.ts). A missing row is treated as
/// all-categories-on in code — no backfill migration needed for existing
/// users. REQUIRED notification types (moderation outcomes, order
/// confirmation, submission receipts, unable-to-source) ignore these
/// entirely — there is no column that could even suppress them.
model NotificationPreference {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ordersDeliveryEmail     Boolean @default(true)
  quotationsSourcingEmail Boolean @default(true)
  messagesEmail           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preference")
}

// ---------------------------------------------------------------------------
// M11 — Vendor Finance, Earnings, Settlement & Payout Management
//
// The other half of the marketplace financial lifecycle (M9 covers customer-
// side refunds/adjustments; M10A-B covers customer payment collection). This
// section implements the mechanism ADR 0005 designed but never built:
// VendorEarning is the actual, implemented per-line payable lifecycle
// (superseding the never-populated FulfilmentItem.payoutEligibility, removed
// this milestone); VendorFinancialAdjustment is ADR 0005's PayoutAdjustment,
// additive-only, never rewriting an earning's original snapshot;
// VendorSettlement/VendorSettlementItem are the manual-payout-mode batching
// unit (one Vendor per Settlement). No automated disbursement API is called
// anywhere in this section — see docs/decisions/0009-vendor-earnings-and-settlement.md.
// ---------------------------------------------------------------------------

enum EarningStatus {
  /// Fulfilment work is still outstanding — the Vendor hasn't delivered yet.
  PENDING
  /// (M11.1) Fulfilment has reached DELIVERED, but the configured post-
  /// delivery settlement window (VENDOR_PAYOUT_HOLD_HOURS) hasn't elapsed
  /// yet. Distinct from PENDING so "waiting on the Vendor" and "waiting on
  /// the clock" are never conflated in either the data or the UI.
  WAITING_PERIOD
  ON_HOLD
  ELIGIBLE
  INCLUDED_IN_SETTLEMENT
  PAID
  CANCELLED
}

/// The authoritative per-line financial obligation CrownSourceGlobal owes a
/// Vendor — one row per FulfilmentItem (the smallest vendor-attributable,
/// quantity-correct unit; deliberately NOT per-Order or per-OrderItem, so a
/// multi-vendor Order produces independent, independently-holdable
/// earnings, and a partial-quantity split across Fulfilments produces
/// independent earnings too). Created transactionally at the same moment
/// its FulfilmentItem is created (Order confirmation, or a resolution-case
/// replacement fulfilment) — never reconstructed later from history.
///
/// `originalPayableAmount` is copied once, from FulfilmentItem.vendorPayableBasis,
/// and is NEVER rewritten afterward (the financial snapshot rule). Every
/// correction is an additive VendorFinancialAdjustment row instead.
model VendorEarning {
  id     String        @id @default(cuid())
  status EarningStatus @default(PENDING)

  currency              String  @default("GHS")
  originalPayableAmount Decimal @db.Decimal(12, 2)

  /// Vendor-facing copy only when set (e.g. "Order issue under review") —
  /// never an internal note. See VendorFinance module policy for exact copy.
  holdReasonSafe   String?
  /// Admin-only — never surfaced to the Vendor.
  holdInternalNote String?
  heldAt           DateTime?
  heldByUserId     String?
  releasedAt       DateTime?
  releasedByUserId String?

  /// Set only when the current/most-recent hold originated from a
  /// ResolutionCase (as opposed to a manual admin hold) — precisely targets
  /// which earnings resolutionsService.resolveCase() should release,
  /// without string-matching holdInternalNote. Cleared on release.
  heldForResolutionCaseId String?
  heldForResolutionCase   ResolutionCase? @relation(fields: [heldForResolutionCaseId], references: [id])

  /// Set once every gating condition (Fulfilment DELIVERED, configured hold
  /// window elapsed, no active hold) is first met.
  eligibleAt DateTime?

  /// (M11.1) Set once, event-driven, the moment the parent Fulfilment first
  /// reaches DELIVERED — this is what starts the WAITING_PERIOD clock the
  /// sweep reads from. Never re-derived from Shipment history afterward; a
  /// hold/release cycle never clears it, since it records a physical fact
  /// (delivery happened), not the current lifecycle status.
  deliveredAt DateTime?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id])

  fulfilmentItemId String         @unique
  fulfilmentItem   FulfilmentItem @relation(fields: [fulfilmentItemId], references: [id])

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  adjustments    VendorFinancialAdjustment[]
  settlementItem VendorSettlementItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([orderId])
  @@index([status, eligibleAt])
  @@map("vendor_earning")
}

enum AdjustmentCategory {
  RESOLUTION_REFUND
  MANUAL_CORRECTION
  SETTLEMENT_REVERSAL
}

/// Additive-only financial correction (ADR 0005's PayoutAdjustment,
/// implemented) — never a rewrite of VendorEarning.originalPayableAmount.
/// May be created against an earning that hasn't been settled yet (nets in
/// before its first Settlement) or one that's already PAID (nets into a
/// FUTURE Settlement — see docs/workflows/workflows.md Workflow J,
/// "post-settlement refund").
model VendorFinancialAdjustment {
  id       String             @id @default(cuid())
  amount   Decimal            @db.Decimal(12, 2) // signed — negative reduces what's owed
  category AdjustmentCategory
  reason   String

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  vendorEarningId String
  vendorEarning   VendorEarning @relation(fields: [vendorEarningId], references: [id])

  resolutionCaseId String?
  resolutionCase   ResolutionCase? @relation(fields: [resolutionCaseId], references: [id])

  /// Null until swept into a Settlement (createSettlement sweeps every
  /// unapplied adjustment for the vendor) — never appliable twice.
  appliedToSettlementId String?
  appliedToSettlement   VendorSettlement? @relation(fields: [appliedToSettlementId], references: [id])

  /// Null for a system-triggered adjustment (a resolution-case refund);
  /// set for an admin-authored manual correction or reversal.
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([vendorId, appliedToSettlementId])
  @@index([vendorEarningId])
  @@map("vendor_financial_adjustment")
}

enum SettlementStatus {
  DRAFT
  APPROVED
  /// (M12) An automated Paystack payout has been initiated and Paystack has
  /// not yet confirmed a terminal outcome. Never entered by a manual
  /// "Record External Payout" — that goes straight APPROVED -> PAID.
  PROCESSING
  PAID
  /// (M12) Paystack confirmed the transfer did not succeed. Distinct from
  /// PROCESSING's "uncertain" — FAILED means the provider gave a definitive
  /// negative answer, so retry is safe. Earnings stay INCLUDED_IN_SETTLEMENT
  /// (never silently reverted) — Admin retries or cancels explicitly.
  FAILED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

/// One Vendor per Settlement (no multi-vendor batching). Two payout paths,
/// mutually exclusive by construction (both key off the same guarded status
/// transition, so only one can ever apply):
///   - Manual: APPROVED -> PAID directly via recordPayout (admin already
///     sent money externally and is only recording it).
///   - Automated (M12): APPROVED/FAILED -> PROCESSING -> PAID/FAILED via a
///     real Paystack Transfer, see modules/vendor-finance/payout-provider.ts.
/// DRAFT/APPROVED/FAILED -> CANCELLED releases its earnings back to
/// ELIGIBLE. Never mutated after PAID except the additive
/// reversedAt/reversalReason correction fields below — the originally
/// recorded amount/reference always stays visible (no deletion of
/// financial history).
model VendorSettlement {
  id               String           @id @default(cuid())
  settlementNumber String           @unique
  status           SettlementStatus @default(DRAFT)
  currency         String           @default("GHS")

  /// Sum of included earnings' originalPayableAmount at inclusion time.
  grossPayable    Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of adjustments swept in at creation time (signed).
  adjustmentTotal Decimal @default(0) @db.Decimal(12, 2)
  /// grossPayable + adjustmentTotal — the actual amount to pay. Always > 0;
  /// a settlement whose net would be <= 0 is never created.
  netAmount       Decimal @default(0) @db.Decimal(12, 2)

  approvedByUserId String?
  approvedAt       DateTime?

  /// Snapshot of VendorPayoutDestination taken at approval time — later
  /// Vendor changes to their payout destination never alter this record.
  destinationSnapshot Json?

  payoutMethod            PayoutMethod?
  payoutExternalReference String?
  payoutNote              String?
  payoutPaidAt            DateTime?
  payoutRecordedByUserId  String?

  /// (M12) Set only for the automated path — "PAYSTACK" once a real
  /// transfer has been initiated. Null for a manually-recorded payout. This
  /// is the field the UI/admin uses to tell the two paths apart; the status
  /// transitions themselves are what actually prevents them conflicting.
  payoutProvider String?

  /// (M12) CrownSourceGlobal's own reference for this payout attempt —
  /// generated once when "Send Payout"/"Retry Payout" is first clicked,
  /// sent to Paystack as `reference`, and the key used to independently
  /// re-verify status later (poll, webhook, or admin "Check status") —
  /// never trusting a webhook body alone. Regenerated on each retry, since
  /// a FAILED attempt is a known dead end and Paystack references must be
  /// unique. This is also the row-level guard against a double-click: the
  /// claim that sets this is a guarded updateMany keyed on the settlement's
  /// OWN status, so two concurrent clicks can only ever have one winner.
  payoutProviderReference String? @unique

  /// (M12) Paystack's transfer_code for the current/most recent attempt —
  /// used to look up the transfer in the Paystack dashboard for diagnostics.
  payoutProviderTransferCode String?

  /// (M12) Paystack's recipient_code, resolved once from this settlement's
  /// own destinationSnapshot and reused on retry (never recreated) — one
  /// recipient per settlement, matching the settlement's own immutable
  /// destination snapshot rather than the vendor's possibly-since-changed
  /// current destination.
  payoutProviderRecipientCode String?

  payoutInitiatedAt       DateTime?
  payoutInitiatedByUserId String?

  /// (M12) Admin-facing reason set only when status = FAILED — cleared on
  /// retry. Never shown to the Vendor (see toVendorPayoutStatus).
  payoutFailureReasonSafe String?

  /// Additive correction for a wrongly-recorded payout — never edits the
  /// payout fields above. See docs/decisions/0009-vendor-earnings-and-settlement.md.
  reversedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  items       VendorSettlementItem[]
  adjustments VendorFinancialAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("vendor_settlement")
}

/// One row per included Earning — @unique on vendorEarningId is the DB-level
/// "an earning can never enter two Settlements, ever" guarantee.
model VendorSettlementItem {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(12, 2) // snapshot of the earning's originalPayableAmount at inclusion

  settlementId String
  settlement   VendorSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  vendorEarningId String        @unique
  vendorEarning   VendorEarning @relation(fields: [vendorEarningId], references: [id])

  createdAt DateTime @default(now())

  @@index([settlementId])
  @@map("vendor_settlement_item")
}

enum PayoutDestinationType {
  MOBILE_MONEY
  BANK_TRANSFER
}

/// Vendor's own payout destination — financially sensitive, OWNER-only
/// mutation (modules/vendor-finance/policy.ts), never derived from the
/// private pickup/contact fields on Vendor. Only one active destination per
/// Vendor for V1 — no destination history table; a Settlement's
/// destinationSnapshot is the historical record once one has been used.
model VendorPayoutDestination {
  id   String                @id @default(cuid())
  type PayoutDestinationType

  /// Set only when type = MOBILE_MONEY.
  momoAccountName String?
  momoPhone       String?
  momoNetwork     PaymentNetwork?

  /// Set only when type = BANK_TRANSFER.
  bankAccountName   String?
  bankName          String?
  bankAccountNumber String?

  updatedByUserId String

  vendorId String @unique
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_payout_destination")
}

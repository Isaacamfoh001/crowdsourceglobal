# PostgreSQL connection string.
# Local dev example (Homebrew Postgres, trust auth, current OS user):
#   postgresql://YOUR_OS_USER@localhost:5432/crownsourceglobal_dev
DATABASE_URL="postgresql://user:password@localhost:5432/crownsourceglobal_dev"

# Base URL Better Auth uses to build callback/verification/reset links.
BETTER_AUTH_URL="http://localhost:3000"

# Random secret used by Better Auth to sign sessions/tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth ("Continue with Google").
# Obtain from https://console.cloud.google.com/apis/credentials
# - Create an OAuth 2.0 Client ID (Web application).
# - Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
#   (for local dev: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Public app URL, used by the client-side auth SDK.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# How many days an instant quotation stays acceptable after issuance.
# Optional — defaults to 7 if unset.
QUOTE_VALIDITY_DAYS=7

# Transactional email delivery.
# "console" (default) logs emails to the server console — no configuration
# needed for local development. Set to "resend" in production, which then
# REQUIRES RESEND_API_KEY and EMAIL_FROM below (the app fails fast at
# startup otherwise).
EMAIL_PROVIDER=console

# Only required when EMAIL_PROVIDER=resend.
# Obtain from https://resend.com/api-keys — server-only, never expose to the client.
RESEND_API_KEY=

# Only required when EMAIL_PROVIDER=resend.
# Must be a sender address on a domain verified in your Resend account.
EMAIL_FROM="CrownSourceGlobal <notifications@your-verified-domain.com>"

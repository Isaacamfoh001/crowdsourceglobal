# PostgreSQL connection string.
# Local dev example (Homebrew Postgres, trust auth, current OS user):
#   postgresql://YOUR_OS_USER@localhost:5432/crownsourceglobal_dev
DATABASE_URL="postgresql://user:password@localhost:5432/crownsourceglobal_dev"

# Base URL Better Auth uses to build callback/verification/reset links.
BETTER_AUTH_URL="http://localhost:3000"

# Random secret used by Better Auth to sign sessions/tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth ("Continue with Google").
# Obtain from https://console.cloud.google.com/apis/credentials
# - Create an OAuth 2.0 Client ID (Web application).
# - Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
#   (for local dev: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Public app URL, used by the client-side auth SDK.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# How many days an instant quotation stays acceptable after issuance.
# Optional — defaults to 7 if unset.
QUOTE_VALIDITY_DAYS=7

# Transactional email delivery.
# "console" (default) logs emails to the server console — no configuration
# needed for local development. Set to "resend" in production, which then
# REQUIRES RESEND_API_KEY and EMAIL_FROM below (the app fails fast at
# startup otherwise).
EMAIL_PROVIDER=console

# Only required when EMAIL_PROVIDER=resend.
# Obtain from https://resend.com/api-keys — server-only, never expose to the client.
RESEND_API_KEY=

# Only required when EMAIL_PROVIDER=resend.
# Must be a sender address on a domain verified in your Resend account.
EMAIL_FROM="CrownSourceGlobal <notifications@your-verified-domain.com>"

# Admin operations dashboard (M8) — staff-attention ageing thresholds, in
# hours (days for the sourcing deadline warning). These are operational
# defaults, not contractual SLAs; all are optional and default to the
# values below if unset.
OPS_VENDOR_APPLICATION_WARNING_HOURS=24
OPS_LISTING_REVIEW_WARNING_HOURS=48
OPS_MESSAGE_RESPONSE_WARNING_HOURS=4
OPS_SOURCING_STALE_HOURS=24
OPS_FULFILMENT_PREPARING_WARNING_HOURS=48
OPS_SOURCING_DEADLINE_WARNING_DAYS=3

# Post-purchase resolution dashboard (M9) — same "operational default, not
# a contractual SLA" reasoning as the OPS_* vars above.
OPS_RESOLUTION_UNASSIGNED_WARNING_HOURS=12
OPS_RESOLUTION_REVIEW_WARNING_HOURS=24
OPS_RETURN_INSPECTION_WARNING_HOURS=48

# Payment provider (M10A / M10A.2). "mock" (default) — deterministic,
# synchronous, dev/test only, never permitted when NODE_ENV=production (the
# app fails fast at startup otherwise). "paystack" — the PRIMARY real
# provider, Ghana Mobile Money via Paystack's Charge API, requires the
# PAYSTACK_* variables below. "moolre" — experimental/deferred, kept
# selectable for development/experimental testing only (see
# docs/decisions/0007), requires the MOOLRE_* variables below.
PAYMENT_PROVIDER=mock

# Selects Paystack's mode. Deliberately independent of NODE_ENV — a
# production deploy must never accidentally run against test-mode
# credentials, or vice versa. "test" (default) | "live". The app fails fast
# at startup if the PAYSTACK_SECRET_KEY prefix (sk_test_/sk_live_) doesn't
# match this setting.
PAYSTACK_ENV=test

# Only required when PAYMENT_PROVIDER=paystack. From your Paystack
# dashboard's Settings → API Keys & Webhooks — see the "ISAAC — PAYSTACK
# SETUP" section of the M10A.2 implementation report for exact steps. Put
# each value directly in this file; never paste them into chat. Server-only
# — never expose PAYSTACK_SECRET_KEY via NEXT_PUBLIC_*.
PAYSTACK_SECRET_KEY=
# Only needed if a future card/checkout integration surface requires it
# client-side — the Ghana MoMo Charge API flow implemented here does not.
PAYSTACK_PUBLIC_KEY=

# Selects Moolre's base URL (experimental/deferred provider). Deliberately
# independent of NODE_ENV, same reasoning as PAYSTACK_ENV above.
# "sandbox" (default) | "production".
MOOLRE_ENV=sandbox

# Only required when PAYMENT_PROVIDER=moolre. From your Moolre dashboard —
# see the "ISAAC — MOOLRE SETUP" section of the M10A implementation report
# for exactly where to find each of these. Put each value directly in this
# file; never paste them into chat.
MOOLRE_API_USER=
# Moolre's "public" transactional key (X-API-PUBKEY) — used for payment
# initiate/status calls. Distinct from the private account-management key below.
MOOLRE_API_PUBKEY=
# Moolre's private account-management key (X-API-KEY) — only needed if you
# ever call the account create/update/status endpoints directly; not used
# by the app's runtime payment flow.
MOOLRE_API_KEY=
MOOLRE_ACCOUNT_NUMBER=
